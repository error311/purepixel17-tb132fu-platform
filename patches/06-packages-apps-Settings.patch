+import org.robolectric.Shadows;
+import org.robolectric.shadows.ShadowActivity;
+
+import java.util.Locale;
+
+@RunWith(RobolectricTestRunner.class)
+public class SetupWizardLocalePickerActivityTest {
+
+    @Test
+    public void onLocaleSelected_returnsSelectedLocale() {
+        final SetupWizardLocalePickerActivity activity = spy(
+                Robolectric.buildActivity(SetupWizardLocalePickerActivity.class).get());
+        final LocaleStore.LocaleInfo localeInfo =
+                LocaleStore.getLocaleInfo(Locale.forLanguageTag("en-US"));
+        doNothing().when(activity).updateSystemLocale(any(Locale.class));
+
+        activity.onLocaleSelected(localeInfo);
+
+        final ShadowActivity shadowActivity = Shadows.shadowOf(activity);
+        assertEquals(Activity.RESULT_OK, shadowActivity.getResultCode());
+        assertNotNull(shadowActivity.getResultIntent().getSerializableExtra(
+                LocaleListEditor.INTENT_LOCALE_KEY));
