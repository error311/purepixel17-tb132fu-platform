+package com.android.settings.deviceinfo.firmwareversion;
+
+import static com.google.common.truth.Truth.assertThat;
+
+import android.content.Context;
+import android.system.OsConstants;
+
+import androidx.test.core.app.ApplicationProvider;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+
+@RunWith(RobolectricTestRunner.class)
+public final class PurePixelSecurityStateTest {
+    private final Context mContext = ApplicationProvider.getApplicationContext();
+
+    @Test
+    public void bootloader_agreeingLockedSignals_reportsLocked() {
+        assertSummary(
+                PurePixelSecurityState.KEY_BOOTLOADER,
+                snapshot(
+                        "1",
+                        "locked",
+                        "",
+                        "",
+                        PurePixelSecurityState.SelinuxState.ENFORCING,
+                        true,
+                        true,
+                        "file",
+                        "L3"),
+                "Locked");
+    }
+
+    @Test
+    public void bootloader_conflictingSignals_reportsInconsistent() {
+        assertSummary(
+                PurePixelSecurityState.KEY_BOOTLOADER,
+                snapshot(
+                        "0",
+                        "locked",
+                        "",
+                        "",
+                        PurePixelSecurityState.SelinuxState.ENFORCING,
+                        true,
+                        true,
+                        "file",
+                        "L3"),
+                "Inconsistent");
+    }
+
+    @Test
+    public void bootloader_singleSignal_reportsItsState() {
+        assertSummary(
+                PurePixelSecurityState.KEY_BOOTLOADER,
+                snapshot(
+                        "",
+                        "unlocked",
+                        "",
+                        "",
+                        PurePixelSecurityState.SelinuxState.ENFORCING,
+                        true,
+                        true,
+                        "file",
+                        "L3"),
+                "Unlocked");
+    }
+
+    @Test
+    public void verifiedBoot_reportsExactKnownColor() {
+        assertSummary(
+                PurePixelSecurityState.KEY_VERIFIED_BOOT,
+                snapshot(
+                        "",
+                        "",
+                        "green",
+                        "",
+                        PurePixelSecurityState.SelinuxState.ENFORCING,
+                        true,
+                        true,
+                        "file",
+                        "L3"),
+                "GREEN");
+    }
+
+    @Test
+    public void verityMode_reportsEnforcing() {
+        assertSummary(
+                PurePixelSecurityState.KEY_VERITY_MODE,
+                snapshot(
+                        "",
+                        "",
+                        "",
+                        "enforcing",
+                        PurePixelSecurityState.SelinuxState.ENFORCING,
+                        true,
+                        true,
+                        "file",
+                        "L3"),
+                "Enforcing");
+    }
+
+    @Test
+    public void selinux_reportsPermissiveOnlyWhenEnabledButNotEnforced() {
+        assertSummary(
+                PurePixelSecurityState.KEY_SELINUX,
+                snapshot(
+                        "",
+                        "",
+                        "",
+                        "",
+                        PurePixelSecurityState.SelinuxState.PERMISSIVE,
+                        true,
+                        true,
+                        "file",
+                        "L3"),
+                "Permissive");
+    }
+
+    @Test
+    public void selinux_reportsEnforcingFromLiveOrDeniedRead() {
+        assertSummary(
+                PurePixelSecurityState.KEY_SELINUX,
+                snapshot(
+                        "",
+                        "",
+                        "",
+                        "",
+                        PurePixelSecurityState.SelinuxState.ENFORCING,
+                        true,
+                        true,
+                        "file",
+                        "L3"),
+                "Enforcing");
+    }
+
+    @Test
+    public void selinux_unavailableDoesNotClaimPermissive() {
+        assertSummary(
+                PurePixelSecurityState.KEY_SELINUX,
+                snapshot(
+                        "",
+                        "",
+                        "",
+                        "",
+                        PurePixelSecurityState.SelinuxState.UNAVAILABLE,
+                        true,
+                        true,
+                        "file",
+                        "L3"),
+                "Not available");
+    }
+
+    @Test
+    public void selinux_worldReadableNodeDenied_reportsEnforcing() {
+        assertThat(
+                        PurePixelSecurityState.classifySelinuxReadFailure(
+                                OsConstants.S_IROTH, OsConstants.EACCES))
+                .isEqualTo(PurePixelSecurityState.SelinuxState.ENFORCING);
+        assertThat(
+                        PurePixelSecurityState.classifySelinuxReadFailure(
+                                OsConstants.S_IROTH, OsConstants.EPERM))
+                .isEqualTo(PurePixelSecurityState.SelinuxState.ENFORCING);
+    }
+
+    @Test
+    public void selinux_unrelatedReadFailure_reportsUnavailable() {
+        assertThat(
+                        PurePixelSecurityState.classifySelinuxReadFailure(
+                                OsConstants.S_IROTH, OsConstants.ENOENT))
+                .isEqualTo(PurePixelSecurityState.SelinuxState.UNAVAILABLE);
+        assertThat(PurePixelSecurityState.classifySelinuxReadFailure(0, OsConstants.EACCES))
+                .isEqualTo(PurePixelSecurityState.SelinuxState.UNAVAILABLE);
+    }
+
+    @Test
+    public void encryption_reportsFileBasedEncryption() {
+        assertSummary(
+                PurePixelSecurityState.KEY_ENCRYPTION,
+                snapshot(
+                        "",
+                        "",
+                        "",
+                        "",
+                        PurePixelSecurityState.SelinuxState.ENFORCING,
+                        true,
+                        true,
+                        "file",
+                        "L3"),
+                "File-based encryption (FBE)");
+    }
+
+    @Test
+    public void widevine_reportsNormalizedPluginLevel() {
+        assertSummary(
+                PurePixelSecurityState.KEY_WIDEVINE,
+                snapshot(
+                        "",
+                        "",
+                        "",
+                        "",
+                        PurePixelSecurityState.SelinuxState.ENFORCING,
+                        true,
+                        true,
+                        "file",
+                        " l3 "),
+                "L3");
+    }
+
+    @Test
+    public void unknownValues_failClosedToNotAvailable() {
+        final PurePixelSecurityState.Snapshot snapshot =
+                snapshot(
+                        "",
+                        "",
+                        "purple",
+                        "surprise",
+                        PurePixelSecurityState.SelinuxState.ENFORCING,
+                        true,
+                        true,
+                        "file",
+                        "software-ish");
+
+        assertSummary(PurePixelSecurityState.KEY_BOOTLOADER, snapshot, "Not available");
+        assertSummary(PurePixelSecurityState.KEY_VERIFIED_BOOT, snapshot, "Not available");
+        assertSummary(PurePixelSecurityState.KEY_VERITY_MODE, snapshot, "Not available");
+        assertSummary(PurePixelSecurityState.KEY_WIDEVINE, snapshot, "Not available");
+    }
+
+    private void assertSummary(
+            String key, PurePixelSecurityState.Snapshot snapshot, String expected) {
+        assertThat(PurePixelSecurityState.getSummary(mContext, key, snapshot).toString())
+                .isEqualTo(expected);
+    }
+
+    private static PurePixelSecurityState.Snapshot snapshot(
+            String flashLocked,
+            String vbmetaDeviceState,
+            String verifiedBootState,
+            String verityMode,
+            PurePixelSecurityState.SelinuxState selinuxState,
+            boolean encrypted,
+            boolean fileEncrypted,
+            String cryptoType,
+            String widevineSecurityLevel) {
+        return new PurePixelSecurityState.Snapshot(
+                flashLocked,
+                vbmetaDeviceState,
+                verifiedBootState,
+                verityMode,
+                selinuxState,
+                encrypted,
+                fileEncrypted,
+                cryptoType,
+                widevineSecurityLevel);
+    }
+}
