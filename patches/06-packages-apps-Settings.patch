@@ -0,0 +1,123 @@
+/*
+ * Copyright (C) 2026 The Android Open Source Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.settings.tb132fu;
+
+import android.content.ActivityNotFoundException;
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.PackageManager;
+import android.database.ContentObserver;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.UserHandle;
+import android.provider.Settings;
+import android.widget.Toast;
+
+import androidx.preference.Preference;
+import androidx.preference.PreferenceScreen;
+
+import com.android.settings.R;
+import com.android.settings.core.BasePreferenceController;
+import com.android.settingslib.core.lifecycle.LifecycleObserver;
+import com.android.settingslib.core.lifecycle.events.OnStart;
+import com.android.settingslib.core.lifecycle.events.OnStop;
+
+/** Exposes Lenovo Precision Pen status and settings in System > Interaction. */
+public final class Tb132fuPenPreferenceController extends BasePreferenceController
+        implements LifecycleObserver, OnStart, OnStop {
+    private static final String SETTING_PEN_ATTACHED = "tb132fu_pen_attached";
+    private static final String SETTING_PEN_LEVEL = "tb132fu_pen_battery_level";
+    private static final ComponentName LENOVO_PEN_SETTINGS =
+            new ComponentName("com.lenovo.penservice", "com.lenovo.pen.bt.ui.BtSettingsActivity");
+
+    private Preference mPreference;
+    private final ContentObserver mPenStateObserver =
+            new ContentObserver(new Handler(Looper.getMainLooper())) {
+                @Override
+                public void onChange(boolean selfChange) {
+                    updateState(mPreference);
+                }
+            };
+
+    public Tb132fuPenPreferenceController(Context context, String key) {
+        super(context, key);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return Tb132fuUtils.isTb132fu() ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+
+    @Override
+    public void displayPreference(PreferenceScreen screen) {
+        super.displayPreference(screen);
+        mPreference = screen.findPreference(getPreferenceKey());
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        if (preference == null) {
+            return;
+        }
+        final boolean settingsAvailable =
+                mContext.getPackageManager()
+                                .resolveActivity(
+                                        new Intent().setComponent(LENOVO_PEN_SETTINGS),
+                                        PackageManager.MATCH_SYSTEM_ONLY)
+                        != null;
+        preference.setEnabled(settingsAvailable);
+        if (!settingsAvailable) {
+            preference.setSummary(R.string.tb132fu_pen_settings_unavailable_summary);
+            return;
+        }
+
+        final int user = UserHandle.myUserId();
+        final boolean attached =
+                Settings.Secure.getIntForUser(
+                                mContext.getContentResolver(), SETTING_PEN_ATTACHED, 0, user)
+                        != 0;
+        if (!attached) {
+            preference.setSummary(R.string.tb132fu_pen_not_connected);
+            return;
+        }
+        final int level =
+                Settings.Secure.getIntForUser(
+                        mContext.getContentResolver(), SETTING_PEN_LEVEL, -1, user);
+        preference.setSummary(
+                level >= 0 && level <= 100
+                        ? mContext.getString(R.string.tb132fu_pen_connected_level, level)
+                        : mContext.getString(R.string.tb132fu_pen_connected));
+    }
+
+    @Override
+    public boolean handlePreferenceTreeClick(Preference preference) {
+        if (!getPreferenceKey().equals(preference.getKey())) {
+            return false;
+        }
+        try {
+            mContext.startActivity(new Intent().setComponent(LENOVO_PEN_SETTINGS));
+        } catch (ActivityNotFoundException exception) {
+            Toast.makeText(mContext, R.string.tb132fu_pen_settings_unavailable, Toast.LENGTH_LONG)
+                    .show();
+        }
+        return true;
+    }
+
+    @Override
+    public void onStart() {
+        mContext.getContentResolver()
+                .registerContentObserver(
+                        Settings.Secure.getUriFor(SETTING_PEN_ATTACHED), false, mPenStateObserver);
+        mContext.getContentResolver()
+                .registerContentObserver(
+                        Settings.Secure.getUriFor(SETTING_PEN_LEVEL), false, mPenStateObserver);
+    }
+
+    @Override
+    public void onStop() {
+        mContext.getContentResolver().unregisterContentObserver(mPenStateObserver);
+    }
+}
