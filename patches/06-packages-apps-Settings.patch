@@ -0,0 +1,103 @@
+/*
+ * Copyright (C) 2026 The Android Open Source Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.settings.tb132fu;
+
+import android.content.Context;
+import android.os.UserHandle;
+import android.provider.Settings;
+
+import androidx.preference.ListPreference;
+import androidx.preference.Preference;
+
+import com.android.settings.core.BasePreferenceController;
+
+/** Controls the TB132FU panel's qualified 60/120 Hz policies from Display settings. */
+public final class Tb132fuRefreshRatePreferenceController extends BasePreferenceController
+        implements Preference.OnPreferenceChangeListener {
+    static final String MODE_STANDARD = "standard";
+    static final String MODE_FLUID = "fluid";
+    static final String MODE_FORCE_120 = "force_120";
+
+    private static final String SETTING_MIN_REFRESH_RATE = "min_refresh_rate";
+    private static final String SETTING_PEAK_REFRESH_RATE = "peak_refresh_rate";
+
+    public Tb132fuRefreshRatePreferenceController(Context context, String key) {
+        super(context, key);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return Tb132fuUtils.isTb132fu() ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        final ListPreference listPreference = (ListPreference) preference;
+        final int user = UserHandle.myUserId();
+        final String mode =
+                getRefreshRateMode(
+                        Settings.System.getFloatForUser(
+                                mContext.getContentResolver(),
+                                SETTING_MIN_REFRESH_RATE,
+                                0.0f,
+                                user),
+                        Settings.System.getFloatForUser(
+                                mContext.getContentResolver(),
+                                SETTING_PEAK_REFRESH_RATE,
+                                120.0f,
+                                user));
+        listPreference.setValue(mode);
+        updateSummary(listPreference, mode);
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        final float minimum;
+        final float peak;
+        final String mode = String.valueOf(newValue);
+        switch (mode) {
+            case MODE_STANDARD:
+                minimum = 0.0f;
+                peak = 60.0f;
+                break;
+            case MODE_FLUID:
+                minimum = 0.0f;
+                peak = 120.0f;
+                break;
+            case MODE_FORCE_120:
+                minimum = 120.0f;
+                peak = 120.0f;
+                break;
+            default:
+                return false;
+        }
+
+        final int user = UserHandle.myUserId();
+        final boolean minimumStored =
+                Settings.System.putFloatForUser(
+                        mContext.getContentResolver(), SETTING_MIN_REFRESH_RATE, minimum, user);
+        final boolean peakStored =
+                Settings.System.putFloatForUser(
+                        mContext.getContentResolver(), SETTING_PEAK_REFRESH_RATE, peak, user);
+        if (minimumStored && peakStored) {
+            updateSummary((ListPreference) preference, mode);
+        }
+        return minimumStored && peakStored;
+    }
+
+    static String getRefreshRateMode(float minimum, float peak) {
+        if (minimum >= 119.0f) {
+            return MODE_FORCE_120;
+        }
+        return peak >= 119.0f ? MODE_FLUID : MODE_STANDARD;
+    }
+
+    private static void updateSummary(ListPreference preference, String mode) {
+        final int index = preference.findIndexOfValue(mode);
+        if (index >= 0) {
+            preference.setSummary(preference.getEntries()[index]);
+        }
+    }
+}
