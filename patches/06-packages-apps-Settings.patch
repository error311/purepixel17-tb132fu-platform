+import com.android.settingslib.metadata.SensitivityLevel
+import com.android.settingslib.preference.PreferenceBinding
+
+/** Static identity shown on the Android version screen for this ROM. */
+abstract class PurePixelIdentityPreference(
+    final override val key: String,
+    @StringRes final override val title: Int,
+) : PersistentPreference<String>, PreferenceMetadata, PreferenceSummaryProvider, PreferenceBinding {
+
+    override val purpose: Int
+        get() = R.string.pure_pixel_identity_purpose
+
+    override val indexable
+        get() = false
+
+    override fun tags(context: Context) = arrayOf(TAG_DEVICE_STATE_PREFERENCE)
+
+    override val supportsWrite = false
+
+    override val valueType = String::class.javaObjectType
+
+    override fun storage(context: Context): KeyValueStore = createSummaryStorage(context, key)
+
+    override fun bind(preference: Preference, metadata: PreferenceMetadata) {
+        super.bind(preference, metadata)
+        preference.isSelectable = false
+        preference.isCopyingEnabled = true
+    }
+
+    override val sensitivityLevel
+        get() = SensitivityLevel.NO_SENSITIVITY
+}
+
+class PurePixelBuildPreference :
+    PurePixelIdentityPreference(key = "pure_pixel_build", title = R.string.pure_pixel_build_title) {
+    override fun getSummary(context: Context): CharSequence {
+        val isRtl = context.resources.configuration.layoutDirection == LAYOUT_DIRECTION_RTL
+        return BidiFormatter.getInstance(isRtl).unicodeWrap(Build.VERSION.INCREMENTAL)
+    }
+}
+
+class PurePixelMaintainerPreference :
+    PurePixelIdentityPreference(
+        key = "pure_pixel_maintainer",
+        title = R.string.pure_pixel_maintainer_title,
+    ) {
+    override fun getSummary(context: Context): CharSequence =
+        context.getText(R.string.pure_pixel_maintainer_summary)
+}
diff --git a/src/com/android/settings/deviceinfo/firmwareversion/PurePixelSecurityState.java b/src/com/android/settings/deviceinfo/firmwareversion/PurePixelSecurityState.java
new file mode 100644
index 0000000000000000000000000000000000000000..1ddbaf30defdccff375a1b9b4f9f4e1c7010e007
--- /dev/null
+++ b/src/com/android/settings/deviceinfo/firmwareversion/PurePixelSecurityState.java
@@ -0,0 +1,298 @@
+/*
+ * Copyright (C) 2026 The Pure Pixel Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.settings.deviceinfo.firmwareversion;
+
+import android.content.Context;
+import android.media.MediaDrm;
+import android.media.UnsupportedSchemeException;
+import android.os.SELinux;
+import android.os.SystemProperties;
+import android.os.storage.StorageManager;
+import android.system.ErrnoException;
+import android.system.Os;
+import android.system.OsConstants;
+import android.util.Log;
+
+import androidx.annotation.VisibleForTesting;
+
+import com.android.settings.R;
+
+import java.io.FileDescriptor;
+import java.io.InterruptedIOException;
+import java.util.Locale;
+import java.util.UUID;
+
+/** Produces truthful, read-only summaries for the Android-version security rows. */
+public final class PurePixelSecurityState {
+    public static final String KEY_BOOTLOADER = "pure_pixel_bootloader_state";
+    public static final String KEY_VERIFIED_BOOT = "pure_pixel_verified_boot_state";
+    public static final String KEY_VERITY_MODE = "pure_pixel_verity_mode";
+    public static final String KEY_SELINUX = "pure_pixel_selinux_state";
+    public static final String KEY_ENCRYPTION = "pure_pixel_encryption_state";
+    public static final String KEY_WIDEVINE = "pure_pixel_widevine_security_level";
+
+    private static final String TAG = "PurePixelSecurity";
+    private static final String PROPERTY_FLASH_LOCKED = "ro.boot.flash.locked";
+    private static final String PROPERTY_VBMETA_DEVICE_STATE = "ro.boot.vbmeta.device_state";
+    private static final String PROPERTY_VERIFIED_BOOT_STATE = "ro.boot.verifiedbootstate";
+    private static final String PROPERTY_VERITY_MODE = "ro.boot.veritymode";
+    private static final String PROPERTY_CRYPTO_TYPE = "ro.crypto.type";
+    private static final String SELINUX_ENFORCE_PATH = "/sys/fs/selinux/enforce";
+    private static final String WIDEVINE_SECURITY_LEVEL_PROPERTY = "securityLevel";
+    private static final UUID WIDEVINE_UUID =
+            UUID.fromString("edef8ba9-79d6-4ace-a3c8-27dcd51d21ed");
+
+    private PurePixelSecurityState() {}
+
+    public static CharSequence getSummary(Context context, String key) {
+        return getSummary(context, key, Snapshot.read(key));
+    }
+
+    @VisibleForTesting
+    static CharSequence getSummary(Context context, String key, Snapshot snapshot) {
+        final int summary;
+        switch (key) {
+            case KEY_BOOTLOADER:
+                summary = getBootloaderSummary(snapshot);
+                break;
+            case KEY_VERIFIED_BOOT:
+                summary = getVerifiedBootSummary(snapshot.verifiedBootState);
+                break;
+            case KEY_VERITY_MODE:
+                summary = getVerityModeSummary(snapshot.verityMode);
+                break;
+            case KEY_SELINUX:
+                summary = getSelinuxSummary(snapshot);
+                break;
+            case KEY_ENCRYPTION:
+                summary = getEncryptionSummary(snapshot);
+                break;
+            case KEY_WIDEVINE:
+                final String widevineLevel =
+                        normalize(snapshot.widevineSecurityLevel).toUpperCase(Locale.ROOT);
+                if (widevineLevel.equals("L1")
+                        || widevineLevel.equals("L2")
+                        || widevineLevel.equals("L3")) {
+                    return widevineLevel;
+                }
+                summary = R.string.device_info_not_available;
+                break;
+            default:
+                summary = R.string.device_info_not_available;
+                break;
+        }
+        return context.getText(summary);
+    }
+
+    private static int getBootloaderSummary(Snapshot snapshot) {
+        final Boolean flashLocked = parseLocked(snapshot.flashLocked);
+        final Boolean vbmetaLocked = parseLocked(snapshot.vbmetaDeviceState);
+        if (flashLocked != null && vbmetaLocked != null && !flashLocked.equals(vbmetaLocked)) {
+            return R.string.pure_pixel_security_state_inconsistent;
+        }
+        final Boolean locked = flashLocked != null ? flashLocked : vbmetaLocked;
+        if (locked == null) {
+            return R.string.device_info_not_available;
+        }
+        return locked
+                ? R.string.pure_pixel_security_state_locked
+                : R.string.pure_pixel_security_state_unlocked;
+    }
+
+    private static int getVerifiedBootSummary(String value) {
+        switch (normalize(value)) {
+            case "green":
+                return R.string.pure_pixel_security_state_green;
+            case "yellow":
+                return R.string.pure_pixel_security_state_yellow;
+            case "orange":
+                return R.string.pure_pixel_security_state_orange;
+            case "red":
+                return R.string.pure_pixel_security_state_red;
+            default:
+                return R.string.device_info_not_available;
+        }
+    }
+
+    private static int getVerityModeSummary(String value) {
+        switch (normalize(value)) {
+            case "enforcing":
+                return R.string.pure_pixel_security_state_enforcing;
+            case "logging":
+                return R.string.pure_pixel_security_state_logging;
+            case "eio":
+                return R.string.pure_pixel_security_state_eio;
+            case "disabled":
+                return R.string.pure_pixel_security_state_disabled;
+            default:
+                return R.string.device_info_not_available;
+        }
+    }
+
+    private static int getSelinuxSummary(Snapshot snapshot) {
+        switch (snapshot.selinuxState) {
+            case DISABLED:
+                return R.string.pure_pixel_security_state_disabled;
+            case ENFORCING:
+                return R.string.pure_pixel_security_state_enforcing;
+            case PERMISSIVE:
+                return R.string.pure_pixel_security_state_permissive;
+            default:
+                return R.string.device_info_not_available;
+        }
+    }
+
+    private static int getEncryptionSummary(Snapshot snapshot) {
+        if (!snapshot.encrypted) {
+            return R.string.pure_pixel_security_state_not_encrypted;
+        }
+        if (snapshot.fileEncrypted || normalize(snapshot.cryptoType).equals("file")) {
+            return R.string.pure_pixel_security_state_file_encryption;
+        }
+        if (normalize(snapshot.cryptoType).equals("block")) {
+            return R.string.pure_pixel_security_state_full_disk_encryption;
+        }
+        return R.string.pure_pixel_security_state_encrypted;
+    }
+
+    private static Boolean parseLocked(String value) {
+        switch (normalize(value)) {
+            case "1":
+            case "true":
+            case "locked":
+                return true;
+            case "0":
+            case "false":
+            case "unlocked":
+                return false;
+            default:
+                return null;
+        }
+    }
+
+    private static String normalize(String value) {
+        return value == null ? "" : value.trim().toLowerCase(Locale.ROOT);
+    }
+
+    private static String readWidevineSecurityLevel() {
+        try (MediaDrm mediaDrm = new MediaDrm(WIDEVINE_UUID)) {
+            return mediaDrm.getPropertyString(WIDEVINE_SECURITY_LEVEL_PROPERTY);
+        } catch (UnsupportedSchemeException | RuntimeException e) {
+            Log.w(TAG, "Widevine security level is unavailable", e);
+            return "";
+        }
+    }
+
+    private static SelinuxState readSelinuxState() {
+        if (!SELinux.isSELinuxEnabled()) {
+            return SelinuxState.DISABLED;
+        }
+
+        final int mode;
+        try {
+            mode = Os.stat(SELINUX_ENFORCE_PATH).st_mode;
+        } catch (ErrnoException | RuntimeException e) {
+            Log.w(TAG, "SELinux enforcement node is unavailable", e);
+            return SelinuxState.UNAVAILABLE;
+        }
+
+        FileDescriptor descriptor = null;
+        try {
+            descriptor =
+                    Os.open(SELINUX_ENFORCE_PATH, OsConstants.O_RDONLY | OsConstants.O_CLOEXEC, 0);
+            final byte[] value = new byte[1];
+            if (Os.read(descriptor, value, 0, value.length) != value.length) {
+                return SelinuxState.UNAVAILABLE;
+            }
+            if (value[0] == '1') {
+                return SelinuxState.ENFORCING;
+            }
+            if (value[0] == '0') {
+                return SelinuxState.PERMISSIVE;
+            }
+            return SelinuxState.UNAVAILABLE;
+        } catch (ErrnoException e) {
+            return classifySelinuxReadFailure(mode, e.errno);
+        } catch (InterruptedIOException | RuntimeException e) {
+            Log.w(TAG, "Could not read SELinux enforcement state", e);
+            return SelinuxState.UNAVAILABLE;
+        } finally {
+            if (descriptor != null) {
+                try {
+                    Os.close(descriptor);
+                } catch (ErrnoException e) {
+                    Log.w(TAG, "Could not close SELinux enforcement node", e);
+                }
+            }
+        }
+    }
+
+    @VisibleForTesting
+    static SelinuxState classifySelinuxReadFailure(int mode, int errno) {
+        // The kernel exposes this fixed SELinux node as world-readable. If a
+        // process can stat it but an EACCES/EPERM policy check blocks the read,
+        // the denial itself is direct evidence that SELinux is enforcing.
+        if ((mode & OsConstants.S_IROTH) != 0
+                && (errno == OsConstants.EACCES || errno == OsConstants.EPERM)) {
+            return SelinuxState.ENFORCING;
+        }
+        return SelinuxState.UNAVAILABLE;
+    }
+
+    @VisibleForTesting
+    enum SelinuxState {
+        DISABLED,
+        ENFORCING,
+        PERMISSIVE,
+        UNAVAILABLE
+    }
+
+    @VisibleForTesting
+    static final class Snapshot {
+        final String flashLocked;
+        final String vbmetaDeviceState;
+        final String verifiedBootState;
+        final String verityMode;
+        final SelinuxState selinuxState;
+        final boolean encrypted;
+        final boolean fileEncrypted;
+        final String cryptoType;
+        final String widevineSecurityLevel;
+
+        Snapshot(
+                String flashLocked,
+                String vbmetaDeviceState,
+                String verifiedBootState,
+                String verityMode,
+                SelinuxState selinuxState,
+                boolean encrypted,
+                boolean fileEncrypted,
+                String cryptoType,
+                String widevineSecurityLevel) {
+            this.flashLocked = flashLocked;
+            this.vbmetaDeviceState = vbmetaDeviceState;
+            this.verifiedBootState = verifiedBootState;
+            this.verityMode = verityMode;
+            this.selinuxState = selinuxState;
+            this.encrypted = encrypted;
+            this.fileEncrypted = fileEncrypted;
+            this.cryptoType = cryptoType;
+            this.widevineSecurityLevel = widevineSecurityLevel;
+        }
+
+        static Snapshot read(String key) {
+            return new Snapshot(
+                    SystemProperties.get(PROPERTY_FLASH_LOCKED),
+                    SystemProperties.get(PROPERTY_VBMETA_DEVICE_STATE),
+                    SystemProperties.get(PROPERTY_VERIFIED_BOOT_STATE),
