+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+
+@RunWith(RobolectricTestRunner.class)
+public final class BatteryHealthDetailPreferenceControllerTest {
+    private Context mContext;
+    private Intent mBatteryIntent;
+
+    @Before
+    public void setUp() {
+        mContext = spy(ApplicationProvider.getApplicationContext());
+        mBatteryIntent = new Intent()
+                .putExtra(BatteryManager.EXTRA_FULL_CHARGE_CAPACITY_UAH, 6_993_000)
+                .putExtra(BatteryManager.EXTRA_DESIGN_CAPACITY_UAH, 8_000_000)
+                .putExtra(BatteryManager.EXTRA_CYCLE_COUNT, 111)
+                .putExtra(BatteryManager.EXTRA_HEALTH, BatteryManager.BATTERY_HEALTH_GOOD);
+        doReturn(mBatteryIntent).when(mContext).registerReceiver(any(), any());
+    }
+
+    @Test
+    public void maximumCapacity_usesFullAndDesignCapacity() {
+        assertThat(controller(BatteryHealthDetailPreferenceController.KEY_MAXIMUM_CAPACITY)
+                .getSummary()).isEqualTo("87%");
+    }
+
+    @Test
+    public void capacities_areFormattedInMah() {
+        assertThat(controller(BatteryHealthDetailPreferenceController.KEY_FULL_CHARGE_CAPACITY)
+                .getSummary()).isEqualTo("6,993 mAh");
+        assertThat(controller(BatteryHealthDetailPreferenceController.KEY_DESIGN_CAPACITY)
+                .getSummary()).isEqualTo("8,000 mAh");
+    }
+
+    @Test
+    public void cycleCountAndCondition_areReported() {
+        assertThat(controller(BatteryHealthDetailPreferenceController.KEY_CYCLE_COUNT)
+                .getSummary()).isEqualTo("111");
+        assertThat(controller(BatteryHealthDetailPreferenceController.KEY_CONDITION)
+                .getSummary()).isEqualTo(
+                        mContext.getText(R.string.battery_health_condition_good));
+    }
+
+    @Test
+    public void missingGaugeData_isUnavailable() {
+        doReturn(new Intent()).when(mContext).registerReceiver(any(), any());
+
+        assertThat(controller(BatteryHealthDetailPreferenceController.KEY_MAXIMUM_CAPACITY)
+                .getSummary()).isEqualTo(
+                        mContext.getText(R.string.battery_cycle_count_not_available));
+        assertThat(controller(BatteryHealthDetailPreferenceController.KEY_CONDITION)
+                .getSummary()).isEqualTo(
+                        mContext.getText(R.string.battery_cycle_count_not_available));
+    }
+
+    private BatteryHealthDetailPreferenceController controller(String key) {
+        return new BatteryHealthDetailPreferenceController(mContext, key);
+    }
+}
