@@ -0,0 +1,65 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Copyright (C) 2026 The Android Open Source Project
+     SPDX-License-Identifier: Apache-2.0 -->
+<PreferenceScreen
+    xmlns:android="http://schemas.android.com/apk/res/android"
+    xmlns:settings="http://schemas.android.com/apk/res-auto"
+    android:key="battery_health_screen"
+    android:title="@string/battery_health_title">
+
+    <PreferenceCategory
+        android:key="battery_health_care_category"
+        android:title="@string/battery_health_care_category">
+
+        <SwitchPreferenceCompat
+            android:key="battery_health_charge_limit"
+            android:title="@string/battery_health_charge_limit_title"
+            android:summary="@string/battery_health_charge_limit_summary"
+            settings:controller="com.android.settings.fuelgauge.ChargeLimitPreferenceController" />
+    </PreferenceCategory>
+
+    <PreferenceCategory
+        android:key="battery_health_information_category"
+        android:title="@string/battery_health_information_category">
+
+        <Preference
+            android:key="battery_health_maximum_capacity"
+            android:title="@string/battery_health_maximum_capacity"
+            android:summary="@string/summary_placeholder"
+            settings:controller="com.android.settings.fuelgauge.BatteryHealthDetailPreferenceController"
+            settings:enableCopying="true" />
+
+        <Preference
+            android:key="battery_health_full_charge_capacity"
+            android:title="@string/battery_health_full_charge_capacity"
+            android:summary="@string/summary_placeholder"
+            settings:controller="com.android.settings.fuelgauge.BatteryHealthDetailPreferenceController"
+            settings:enableCopying="true" />
+
+        <Preference
+            android:key="battery_health_design_capacity"
+            android:title="@string/battery_health_design_capacity"
+            android:summary="@string/summary_placeholder"
+            settings:controller="com.android.settings.fuelgauge.BatteryHealthDetailPreferenceController"
+            settings:enableCopying="true" />
+
+        <Preference
+            android:key="battery_health_cycle_count"
+            android:title="@string/battery_cycle_count"
+            android:summary="@string/summary_placeholder"
+            settings:controller="com.android.settings.fuelgauge.BatteryHealthDetailPreferenceController"
+            settings:enableCopying="true" />
+
+        <Preference
+            android:key="battery_health_condition"
+            android:title="@string/battery_health_condition"
+            android:summary="@string/summary_placeholder"
+            settings:controller="com.android.settings.fuelgauge.BatteryHealthDetailPreferenceController"
+            settings:enableCopying="true" />
+    </PreferenceCategory>
+
+    <com.android.settingslib.widget.FooterPreference
+        android:key="battery_health_footer"
+        android:title="@string/battery_health_footer"
+        settings:searchable="false" />
+</PreferenceScreen>
