+ * limitations under the License.
+ */
+package com.android.settings.display;
+
+import android.content.Context;
+import android.os.HwBinder;
+import android.os.HwParcel;
+import android.os.IHwBinder;
+import android.os.RemoteException;
+import android.provider.Settings;
+import android.util.Log;
+
+import androidx.annotation.VisibleForTesting;
+
+import com.android.settings.R;
+
+import java.util.NoSuchElementException;
+
+/** Bridges the TB132FU color choices to MediaTek's picture-quality HAL. */
+final class MtkPqColorModeManager {
+    static final String SETTING_KEY = "mtk_color_mode";
+
+    static final int MODE_NORMAL = 0;
+    static final int MODE_VIBRANT = 1;
+    static final int MODE_NATURAL = 2;
+    static final int DEFAULT_MODE = MODE_VIBRANT;
+
+    private static final String TAG = "MtkPqColorMode";
+    private static final String SERVICE_INTERFACE =
+            "vendor.mediatek.hardware.pq@2.15::IPictureQuality";
+    private static final String METHOD_INTERFACE =
+            "vendor.mediatek.hardware.pq@2.0::IPictureQuality";
+    private static final String SERVICE_INSTANCE = "default";
+    private static final int TRANSACTION_SET_PQ_MODE = 3;
+
+    private MtkPqColorModeManager() {}
+
+    static boolean isSupported(Context context) {
+        return context.getResources().getBoolean(R.bool.config_use_mtk_pq_color_modes);
+    }
+
+    static int getColorMode(Context context) {
+        return Settings.Secure.getInt(context.getContentResolver(), SETTING_KEY, DEFAULT_MODE);
+    }
+
+    static boolean setColorMode(Context context, int mode) {
+        return setColorMode(context, mode, MtkPqColorModeManager::applyColorMode);
+    }
+
+    @VisibleForTesting
+    static boolean setColorMode(Context context, int mode, ColorModeApplier applier) {
+        if (!isValidMode(mode)) {
+            Log.w(TAG, "Rejecting invalid color mode " + mode);
+            return false;
+        }
+
+        final int previousMode = getColorMode(context);
+        if (!applier.apply(mode)) {
+            return false;
+        }
+        if (Settings.Secure.putInt(context.getContentResolver(), SETTING_KEY, mode)) {
+            return true;
+        }
+
+        Log.e(TAG, "Could not persist color mode; restoring the previous mode");
+        if (isValidMode(previousMode) && !applier.apply(previousMode)) {
+            Log.e(TAG, "Could not restore the previous color mode");
+        }
+        return false;
+    }
+
+    private static boolean applyColorMode(int mode) {
+        HwParcel request = null;
+        HwParcel reply = null;
+        try {
+            final IHwBinder service = HwBinder.getService(
+                    SERVICE_INTERFACE, SERVICE_INSTANCE);
+            request = new HwParcel();
+            reply = new HwParcel();
+            request.writeInterfaceToken(METHOD_INTERFACE);
+            request.writeInt32(mode);
+            request.writeInt32(0);
+            service.transact(TRANSACTION_SET_PQ_MODE, request, reply, 0);
+            reply.verifySuccess();
+            return true;
+        } catch (RemoteException | NoSuchElementException | SecurityException e) {
+            Log.e(TAG, "Could not apply color mode " + mode, e);
+            return false;
+        } catch (RuntimeException e) {
+            Log.e(TAG, "Picture-quality HAL rejected color mode " + mode, e);
+            return false;
+        } finally {
+            if (request != null) {
+                request.releaseTemporaryStorage();
+                request.release();
+            }
+            if (reply != null) {
+                reply.release();
+            }
+        }
+    }
+
+    private static boolean isValidMode(int mode) {
+        return mode >= MODE_NORMAL && mode <= MODE_NATURAL;
+    }
+
+    @VisibleForTesting
+    interface ColorModeApplier {
+        boolean apply(int mode);
+    }
+}
