+ */
+package com.android.settings.fuelgauge;
+
+import android.content.Context;
+import android.os.SystemProperties;
+import android.util.Log;
+
+import com.android.settings.R;
+import com.android.settings.core.TogglePreferenceController;
+
+/** Controls the TB132FU kernel's persistent, hysteretic battery charge limit. */
+public final class ChargeLimitPreferenceController extends TogglePreferenceController {
+    static final String PROPERTY = "persist.sys.tb132fu.charge_limit";
+    static final int ENABLED_LIMIT = 80;
+    private static final String TAG = "ChargeLimitController";
+
+    public ChargeLimitPreferenceController(Context context, String preferenceKey) {
+        super(context, preferenceKey);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return AVAILABLE;
+    }
+
+    @Override
+    public int getSliceHighlightMenuRes() {
+        return R.string.menu_key_battery;
+    }
+
+    @Override
+    public boolean isChecked() {
+        return SystemProperties.getInt(PROPERTY, 0) == ENABLED_LIMIT;
+    }
+
+    @Override
+    public boolean setChecked(boolean isChecked) {
+        try {
+            SystemProperties.set(PROPERTY, isChecked ? Integer.toString(ENABLED_LIMIT) : "0");
+            return true;
+        } catch (RuntimeException exception) {
+            Log.e(TAG, "Unable to update charge limit", exception);
+            return false;
+        }
+    }
+}
