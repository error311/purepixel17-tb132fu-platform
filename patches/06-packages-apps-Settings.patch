diff --git a/src/com/android/settings/tb132fu/Tb132fuEntryPreferenceController.java b/src/com/android/settings/tb132fu/Tb132fuEntryPreferenceController.java
new file mode 100644
index 0000000000000000000000000000000000000000..7fb0547ba74eff520b2d0433da432ce667fa4009
--- /dev/null
+++ b/src/com/android/settings/tb132fu/Tb132fuEntryPreferenceController.java
@@ -0,0 +1,29 @@
+/*
+ * Copyright (C) 2026 The Android Open Source Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.settings.tb132fu;
+
+import android.content.Context;
+import android.os.Build;
+import android.os.SystemProperties;
+
+import com.android.settings.core.BasePreferenceController;
+
+/** Shows the device page only on the Lenovo TB132FU. */
+public final class Tb132fuEntryPreferenceController extends BasePreferenceController {
+    public Tb132fuEntryPreferenceController(Context context, String key) {
+        super(context, key);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return isTb132fu() ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+
+    static boolean isTb132fu() {
+        return "tb132fu".equalsIgnoreCase(Build.DEVICE)
+                || "tb132fu".equalsIgnoreCase(
+                        SystemProperties.get("ro.product.vendor.device", ""));
+    }
+}
