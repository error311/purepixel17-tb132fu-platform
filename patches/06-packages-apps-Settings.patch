+import android.content.ActivityNotFoundException;
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.PackageManager;
+import android.hardware.display.AmbientDisplayConfiguration;
+import android.hardware.input.InputManager;
+import android.os.Build;
+import android.os.Bundle;
+import android.os.SystemProperties;
+import android.os.UserHandle;
+import android.provider.Settings;
+import android.system.Os;
+import android.util.Log;
+import android.view.InputDevice;
+import android.widget.Toast;
+
+import androidx.preference.ListPreference;
+import androidx.preference.Preference;
+import androidx.preference.SwitchPreferenceCompat;
+
+import com.android.settings.R;
+import com.android.settings.dashboard.DashboardFragment;
+import com.android.settings.search.BaseSearchIndexProvider;
+import com.android.settingslib.search.SearchIndexable;
+
+/** Native Settings surface for behavior owned by the Lenovo TB132FU. */
+@SearchIndexable
+public final class Tb132fuSettingsFragment extends DashboardFragment
+        implements Preference.OnPreferenceChangeListener,
+                Preference.OnPreferenceClickListener {
+    private static final String TAG = "Tb132fuSettings";
+
+    private static final String KEY_AOD = "tb132fu_aod";
+    private static final String KEY_DT2W = "tb132fu_dt2w";
+    private static final String KEY_AOD_SCHEDULE = "tb132fu_aod_twilight_schedule";
+    private static final String KEY_REFRESH_RATE = "tb132fu_refresh_rate";
+    private static final String KEY_PEN_SETTINGS = "tb132fu_pen_settings";
+    private static final String KEY_POGO_STATUS = "tb132fu_pogo_status";
+    private static final String KEY_BUILD_INFO = "tb132fu_build_info";
+
+    private static final String PROP_DT2W = "persist.sys.tb132fu.dt2w";
+    private static final String SETTING_AOD_SCHEDULE =
+            "tb132fu_aod_twilight_schedule";
+    private static final String SETTING_MIN_REFRESH_RATE = "min_refresh_rate";
+    private static final String SETTING_PEAK_REFRESH_RATE = "peak_refresh_rate";
+
+    private static final String REFRESH_STANDARD = "standard";
+    private static final String REFRESH_FLUID = "fluid";
+    private static final String REFRESH_FORCE_120 = "force_120";
+
+    private static final int POGO_VENDOR_ID = 0x17ef;
+    private static final int POGO_PRODUCT_ID = 0x613d;
+    private static final ComponentName LENOVO_PEN_SETTINGS = new ComponentName(
+            "com.lenovo.penservice", "com.lenovo.pen.bt.ui.BtSettingsActivity");
+
+    private SwitchPreferenceCompat mAod;
+    private SwitchPreferenceCompat mDt2w;
+    private SwitchPreferenceCompat mAodSchedule;
+    private ListPreference mRefreshRate;
+    private Preference mPenSettings;
+    private Preference mPogoStatus;
+
+    @Override
+    public void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        mAod = findPreference(KEY_AOD);
+        mDt2w = findPreference(KEY_DT2W);
+        mAodSchedule = findPreference(KEY_AOD_SCHEDULE);
+        mRefreshRate = findPreference(KEY_REFRESH_RATE);
+        mPenSettings = findPreference(KEY_PEN_SETTINGS);
+        mPogoStatus = findPreference(KEY_POGO_STATUS);
+
+        mAod.setOnPreferenceChangeListener(this);
+        mDt2w.setOnPreferenceChangeListener(this);
+        mAodSchedule.setOnPreferenceChangeListener(this);
+        mRefreshRate.setOnPreferenceChangeListener(this);
+        mPenSettings.setOnPreferenceClickListener(this);
+
+        final boolean aodAvailable = new AmbientDisplayConfiguration(getContext())
+                .alwaysOnAvailableForUser(UserHandle.myUserId());
+        mAod.setVisible(aodAvailable);
+        mAodSchedule.setVisible(aodAvailable);
+
+        final Preference buildInfo = findPreference(KEY_BUILD_INFO);
+        buildInfo.setSummary(getString(R.string.tb132fu_build_info_summary,
+                Build.VERSION.RELEASE, getKernelRelease()));
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        final int user = UserHandle.myUserId();
+        mAod.setChecked(Settings.Secure.getIntForUser(getContentResolver(),
+                Settings.Secure.DOZE_ALWAYS_ON, 0, user) != 0);
+        mDt2w.setChecked(SystemProperties.getBoolean(PROP_DT2W,
+                Settings.Secure.getIntForUser(getContentResolver(),
+                        Settings.Secure.DOUBLE_TAP_TO_WAKE, 1, user) != 0));
+        mAodSchedule.setChecked(Settings.Secure.getIntForUser(getContentResolver(),
+                SETTING_AOD_SCHEDULE, 1, user) != 0);
+
+        final String refreshMode = getRefreshRateMode();
+        mRefreshRate.setValue(refreshMode);
+        final int refreshIndex = mRefreshRate.findIndexOfValue(refreshMode);
+        if (refreshIndex >= 0) {
+            mRefreshRate.setSummary(mRefreshRate.getEntries()[refreshIndex]);
+        }
+
+        final boolean penAvailable = getContext().getPackageManager().resolveActivity(
+                new Intent().setComponent(LENOVO_PEN_SETTINGS),
+                PackageManager.MATCH_SYSTEM_ONLY) != null;
+        mPenSettings.setEnabled(penAvailable);
+        mPenSettings.setSummary(penAvailable
+                ? R.string.tb132fu_pen_settings_summary
+                : R.string.tb132fu_pen_settings_unavailable_summary);
+        mPogoStatus.setSummary(isPogoAttached()
+                ? R.string.tb132fu_pogo_attached
+                : R.string.tb132fu_pogo_detached);
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        switch (preference.getKey()) {
+            case KEY_AOD:
+                return Settings.Secure.putIntForUser(getContentResolver(),
+                        Settings.Secure.DOZE_ALWAYS_ON, (Boolean) newValue ? 1 : 0,
+                        UserHandle.myUserId());
+            case KEY_DT2W:
+                return setDt2w((Boolean) newValue);
+            case KEY_AOD_SCHEDULE:
+                return Settings.Secure.putIntForUser(getContentResolver(),
+                        SETTING_AOD_SCHEDULE, (Boolean) newValue ? 1 : 0,
+                        UserHandle.myUserId());
+            case KEY_REFRESH_RATE:
+                return setRefreshRateMode((String) newValue);
+            default:
+                return false;
+        }
+    }
+
+    @Override
+    public boolean onPreferenceClick(Preference preference) {
+        if (!KEY_PEN_SETTINGS.equals(preference.getKey())) {
+            return false;
+        }
+        try {
+            startActivity(new Intent().setComponent(LENOVO_PEN_SETTINGS));
+        } catch (ActivityNotFoundException exception) {
+            Toast.makeText(getContext(), R.string.tb132fu_pen_settings_unavailable,
+                    Toast.LENGTH_LONG).show();
+        }
+        return true;
+    }
+
+    private boolean setDt2w(boolean enabled) {
+        final boolean stored = Settings.Secure.putIntForUser(getContentResolver(),
+                Settings.Secure.DOUBLE_TAP_TO_WAKE, enabled ? 1 : 0,
+                UserHandle.myUserId());
+        return stored && setPersistentBoolean(PROP_DT2W, enabled);
+    }
+
+    private boolean setPersistentBoolean(String property, boolean enabled) {
+        try {
+            SystemProperties.set(property, enabled ? "1" : "0");
+            return true;
+        } catch (RuntimeException exception) {
+            Log.e(TAG, "Unable to set " + property, exception);
+            return false;
+        }
+    }
+
+    private String getRefreshRateMode() {
+        final float minimum = Settings.System.getFloatForUser(getContentResolver(),
+                SETTING_MIN_REFRESH_RATE, 0.0f, UserHandle.myUserId());
+        final float peak = Settings.System.getFloatForUser(getContentResolver(),
+                SETTING_PEAK_REFRESH_RATE, 120.0f, UserHandle.myUserId());
+        if (minimum >= 119.0f) return REFRESH_FORCE_120;
+        return peak >= 119.0f ? REFRESH_FLUID : REFRESH_STANDARD;
+    }
+
+    private boolean setRefreshRateMode(String mode) {
+        final float minimum;
+        final float peak;
+        switch (mode) {
+            case REFRESH_STANDARD:
+                minimum = 0.0f;
+                peak = 60.0f;
+                break;
+            case REFRESH_FLUID:
+                minimum = 0.0f;
+                peak = 120.0f;
+                break;
+            case REFRESH_FORCE_120:
+                minimum = 120.0f;
+                peak = 120.0f;
+                break;
+            default:
+                return false;
+        }
+        final int user = UserHandle.myUserId();
+        final boolean minStored = Settings.System.putFloatForUser(getContentResolver(),
+                SETTING_MIN_REFRESH_RATE, minimum, user);
+        final boolean peakStored = Settings.System.putFloatForUser(getContentResolver(),
+                SETTING_PEAK_REFRESH_RATE, peak, user);
+        if (minStored && peakStored) {
+            final int index = mRefreshRate.findIndexOfValue(mode);
+            if (index >= 0) mRefreshRate.setSummary(mRefreshRate.getEntries()[index]);
+        }
+        return minStored && peakStored;
+    }
+
+    private boolean isPogoAttached() {
+        final InputManager inputManager = getContext().getSystemService(InputManager.class);
+        if (inputManager == null) return false;
+        for (int id : inputManager.getInputDeviceIds()) {
+            final InputDevice device = inputManager.getInputDevice(id);
+            if (device != null && device.isEnabled()
+                    && device.getVendorId() == POGO_VENDOR_ID
+                    && device.getProductId() == POGO_PRODUCT_ID) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static String getKernelRelease() {
+        try {
+            return Os.uname().release;
+        } catch (RuntimeException exception) {
+            return "4.19";
+        }
+    }
+
+    @Override
+    public int getMetricsCategory() {
+        return SettingsEnums.SETTINGS_SYSTEM_CATEGORY;
+    }
+
+    @Override
+    protected String getLogTag() {
+        return TAG;
+    }
+
+    @Override
+    protected int getPreferenceScreenResId() {
+        return R.xml.tb132fu_settings;
+    }
+
+    public static final BaseSearchIndexProvider SEARCH_INDEX_DATA_PROVIDER =
+            new BaseSearchIndexProvider(R.xml.tb132fu_settings) {
+                @Override
+                protected boolean isPageSearchEnabled(Context context) {
+                    return Tb132fuEntryPreferenceController.isTb132fu();
+                }
+            };
+}
