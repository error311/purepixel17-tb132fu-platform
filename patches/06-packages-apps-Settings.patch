index 0000000..e496d0b
--- /dev/null
+++ b/src/com/android/settings/fuelgauge/BatteryHealthDetailPreferenceController.java
@@ -0,0 +1,103 @@
+/*
+ * Copyright (C) 2026 The Android Open Source Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.settings.fuelgauge;
+
+import android.content.Context;
+import android.content.Intent;
+import android.os.BatteryManager;
+
+import com.android.settings.R;
+import com.android.settings.core.BasePreferenceController;
+import com.android.settingslib.fuelgauge.BatteryUtils;
+
+import java.text.NumberFormat;
+
+/** Supplies framework-owned fuel-gauge data to the battery health screen. */
+public class BatteryHealthDetailPreferenceController extends BasePreferenceController {
+    static final String KEY_MAXIMUM_CAPACITY = "battery_health_maximum_capacity";
+    static final String KEY_FULL_CHARGE_CAPACITY = "battery_health_full_charge_capacity";
+    static final String KEY_DESIGN_CAPACITY = "battery_health_design_capacity";
+    static final String KEY_CYCLE_COUNT = "battery_health_cycle_count";
+    static final String KEY_CONDITION = "battery_health_condition";
+
+    private static final int INVALID_VALUE = -1;
+
+    public BatteryHealthDetailPreferenceController(Context context, String preferenceKey) {
+        super(context, preferenceKey);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return AVAILABLE;
+    }
+
+    @Override
+    public CharSequence getSummary() {
+        final Intent batteryIntent = BatteryUtils.getBatteryIntent(mContext);
+        if (batteryIntent == null) {
+            return unavailable();
+        }
+
+        final int fullCapacityUah = batteryIntent.getIntExtra(
+                BatteryManager.EXTRA_FULL_CHARGE_CAPACITY_UAH, INVALID_VALUE);
+        final int designCapacityUah = batteryIntent.getIntExtra(
+                BatteryManager.EXTRA_DESIGN_CAPACITY_UAH, INVALID_VALUE);
+
+        switch (getPreferenceKey()) {
+            case KEY_MAXIMUM_CAPACITY:
+                if (fullCapacityUah <= 0 || designCapacityUah <= 0) {
+                    return unavailable();
+                }
+                final int percent = Math.min(100, Math.max(0,
+                        (int) Math.round(fullCapacityUah * 100.0 / designCapacityUah)));
+                return mContext.getString(R.string.battery_health_percent, percent);
+            case KEY_FULL_CHARGE_CAPACITY:
+                return formatCapacity(fullCapacityUah);
+            case KEY_DESIGN_CAPACITY:
+                return formatCapacity(designCapacityUah);
+            case KEY_CYCLE_COUNT:
+                final int cycleCount = batteryIntent.getIntExtra(
+                        BatteryManager.EXTRA_CYCLE_COUNT, INVALID_VALUE);
+                return cycleCount < 0 ? unavailable() : Integer.toString(cycleCount);
+            case KEY_CONDITION:
+                return formatCondition(batteryIntent.getIntExtra(
+                        BatteryManager.EXTRA_HEALTH, BatteryManager.BATTERY_HEALTH_UNKNOWN));
+            default:
+                return unavailable();
+        }
+    }
+
+    private CharSequence formatCapacity(int capacityUah) {
+        if (capacityUah <= 0) {
+            return unavailable();
+        }
+        final String capacityMah = NumberFormat.getIntegerInstance()
+                .format(Math.round(capacityUah / 1000.0));
+        return mContext.getString(R.string.battery_health_capacity_mah, capacityMah);
+    }
+
+    private CharSequence formatCondition(int condition) {
+        switch (condition) {
+            case BatteryManager.BATTERY_HEALTH_GOOD:
+                return mContext.getText(R.string.battery_health_condition_good);
+            case BatteryManager.BATTERY_HEALTH_OVERHEAT:
+                return mContext.getText(R.string.battery_health_condition_overheat);
+            case BatteryManager.BATTERY_HEALTH_DEAD:
+                return mContext.getText(R.string.battery_health_condition_dead);
+            case BatteryManager.BATTERY_HEALTH_OVER_VOLTAGE:
+                return mContext.getText(R.string.battery_health_condition_over_voltage);
+            case BatteryManager.BATTERY_HEALTH_UNSPECIFIED_FAILURE:
+                return mContext.getText(R.string.battery_health_condition_failure);
+            case BatteryManager.BATTERY_HEALTH_COLD:
+                return mContext.getText(R.string.battery_health_condition_cold);
+            default:
+                return unavailable();
+        }
+    }
+
+    private CharSequence unavailable() {
+        return mContext.getText(R.string.battery_cycle_count_not_available);
+    }
+}
