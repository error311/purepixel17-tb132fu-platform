+ */
+package com.android.settings.fuelgauge;
+
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.PackageManager;
+import android.text.TextUtils;
+
+import androidx.preference.Preference;
+
+import com.android.settings.core.BasePreferenceController;
+
+/** Links the local battery statistics page to Google's optional battery-care UI. */
+public class GoogleBatteryHealthPreferenceController extends BasePreferenceController {
+    static final ComponentName GOOGLE_BATTERY_HEALTH_COMPONENT = new ComponentName(
+            "com.google.android.settings.intelligence",
+            "com.google.android.settings.intelligence.modules.battery.impl.health"
+                    + ".BHSettingsActivity");
+
+    private final Intent mIntent;
+
+    public GoogleBatteryHealthPreferenceController(Context context, String preferenceKey) {
+        super(context, preferenceKey);
+        final Intent intent = new Intent().setComponent(GOOGLE_BATTERY_HEALTH_COMPONENT);
+        mIntent = context.getPackageManager().resolveActivity(
+                intent, PackageManager.MATCH_DEFAULT_ONLY) != null ? intent : null;
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return mIntent != null ? AVAILABLE_UNSEARCHABLE : UNSUPPORTED_ON_DEVICE;
+    }
+
+    @Override
+    public boolean handlePreferenceTreeClick(Preference preference) {
+        if (!TextUtils.equals(preference.getKey(), mPreferenceKey)) {
+            return false;
+        }
+        if (mIntent != null) {
+            mContext.startActivity(mIntent);
+        }
+        return true;
+    }
+}
