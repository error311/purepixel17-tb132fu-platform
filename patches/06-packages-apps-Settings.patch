+package com.android.settings.display;
+
+import static com.google.common.truth.Truth.assertThat;
+
+import android.content.Context;
+import android.provider.Settings;
+
+import androidx.test.core.app.ApplicationProvider;
+
+import org.junit.After;
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+
+import java.util.concurrent.atomic.AtomicInteger;
+
+@RunWith(RobolectricTestRunner.class)
+public class MtkPqColorModeManagerTest {
+    private Context mContext;
+
+    @Before
+    public void setUp() {
+        mContext = ApplicationProvider.getApplicationContext();
+        Settings.Secure.putString(
+                mContext.getContentResolver(), MtkPqColorModeManager.SETTING_KEY, null);
+    }
+
+    @After
+    public void tearDown() {
+        Settings.Secure.putString(
+                mContext.getContentResolver(), MtkPqColorModeManager.SETTING_KEY, null);
+    }
+
+    @Test
+    public void getColorMode_withoutStoredValue_returnsVibrant() {
+        assertThat(MtkPqColorModeManager.getColorMode(mContext))
+                .isEqualTo(MtkPqColorModeManager.MODE_VIBRANT);
+    }
+
+    @Test
+    public void setColorMode_invalidMode_doesNotCallHalOrPersist() {
+        final AtomicInteger calls = new AtomicInteger();
+
+        final boolean result = MtkPqColorModeManager.setColorMode(
+                mContext, 3, mode -> {
+                    calls.incrementAndGet();
+                    return true;
+                });
+
+        assertThat(result).isFalse();
+        assertThat(calls.get()).isEqualTo(0);
+        assertThat(MtkPqColorModeManager.getColorMode(mContext))
+                .isEqualTo(MtkPqColorModeManager.MODE_VIBRANT);
+    }
+
+    @Test
+    public void setColorMode_halFailure_doesNotPersist() {
+        final boolean result = MtkPqColorModeManager.setColorMode(
+                mContext, MtkPqColorModeManager.MODE_NATURAL, mode -> false);
+
+        assertThat(result).isFalse();
+        assertThat(MtkPqColorModeManager.getColorMode(mContext))
+                .isEqualTo(MtkPqColorModeManager.MODE_VIBRANT);
+    }
+
+    @Test
+    public void setColorMode_halSuccess_persistsMode() {
+        final AtomicInteger appliedMode = new AtomicInteger(-1);
+
+        final boolean result = MtkPqColorModeManager.setColorMode(
+                mContext, MtkPqColorModeManager.MODE_NATURAL, mode -> {
+                    appliedMode.set(mode);
+                    return true;
+                });
+
+        assertThat(result).isTrue();
+        assertThat(appliedMode.get()).isEqualTo(MtkPqColorModeManager.MODE_NATURAL);
+        assertThat(MtkPqColorModeManager.getColorMode(mContext))
+                .isEqualTo(MtkPqColorModeManager.MODE_NATURAL);
+    }
+}
