+/** Exposes the TB132FU pogo keyboard/touchpad status in System > Interaction. */
+public final class Tb132fuPogoPreferenceController extends BasePreferenceController
+        implements LifecycleObserver, OnStart, OnStop, InputManager.InputDeviceListener {
+    private static final int POGO_VENDOR_ID = 0x17ef;
+    private static final int POGO_PRODUCT_ID = 0x613d;
+
+    private final InputManager mInputManager;
+    private Preference mPreference;
+
+    public Tb132fuPogoPreferenceController(Context context, String key) {
+        super(context, key);
+        mInputManager = context.getSystemService(InputManager.class);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return Tb132fuUtils.isTb132fu() ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+
+    @Override
+    public void displayPreference(PreferenceScreen screen) {
+        super.displayPreference(screen);
+        mPreference = screen.findPreference(getPreferenceKey());
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        if (preference != null) {
+            preference.setSummary(
+                    isPogoAttached()
+                            ? R.string.tb132fu_pogo_attached
+                            : R.string.tb132fu_pogo_detached);
+        }
+    }
+
+    @Override
+    public boolean handlePreferenceTreeClick(Preference preference) {
+        if (!getPreferenceKey().equals(preference.getKey())) {
+            return false;
+        }
+        try {
+            mContext.startActivity(new Intent(Settings.ACTION_HARD_KEYBOARD_SETTINGS));
+        } catch (ActivityNotFoundException exception) {
+            Toast.makeText(mContext, R.string.tb132fu_pogo_settings_unavailable, Toast.LENGTH_LONG)
+                    .show();
+        }
+        return true;
+    }
+
+    @Override
+    public void onInputDeviceAdded(int deviceId) {
+        updateState(mPreference);
+    }
+
+    @Override
+    public void onInputDeviceRemoved(int deviceId) {
+        updateState(mPreference);
+    }
+
+    @Override
+    public void onInputDeviceChanged(int deviceId) {
+        updateState(mPreference);
+    }
+
+    @Override
+    public void onStart() {
+        if (mInputManager != null) {
+            mInputManager.registerInputDeviceListener(this, null);
+        }
+    }
+
+    @Override
+    public void onStop() {
+        if (mInputManager != null) {
+            mInputManager.unregisterInputDeviceListener(this);
+        }
+    }
+
+    private boolean isPogoAttached() {
+        if (mInputManager == null) {
+            return false;
+        }
+        for (int id : mInputManager.getInputDeviceIds()) {
+            final InputDevice device = mInputManager.getInputDevice(id);
+            if (device != null
+                    && device.isEnabled()
+                    && device.getVendorId() == POGO_VENDOR_ID
+                    && device.getProductId() == POGO_PRODUCT_ID) {
+                return true;
+            }
+        }
+        return false;
+    }
+}
