+
+package com.android.internal.util;
+
+import android.app.Application;
+import android.content.Context;
+import android.os.Build;
+import android.os.Process;
+import android.os.SystemProperties;
+import android.ravenwood.annotation.RavenwoodKeepWholeClass;
+import android.text.TextUtils;
+import android.util.Log;
+
+import java.lang.reflect.Field;
+import java.lang.reflect.Method;
+import java.util.Map;
+
+/**
+ * Supplies the Pixel Tablet UI identity to the Google processes which use
+ * {@link Build} fields to select tablet layouts.
+ *
+ * <p>This is deliberately process-scoped. The operating system and the frozen
+ * Lenovo/MediaTek vendor stack continue to see the real TB132FU identity. Build
+ * ID, fingerprint, security patch, and the GMS attestation process are never
+ * changed here.</p>
+ *
+ * @hide
+ */
+@RavenwoodKeepWholeClass
+public final class PixelTabletAppProps {
+    private static final String TAG = "PixelTabletAppProps";
+    private static final String DEVICE_TB132FU = "tb132fu";
+    private static final String PACKAGE_GOOGLE_SEARCH =
+            "com.google.android.googlequicksearchbox";
+    private static final String PROCESS_GOOGLE_SEARCH_APP =
+            PACKAGE_GOOGLE_SEARCH + ":googleapp";
+    private static final String PROCESS_GOOGLE_SEARCH_SERVICE =
+            PACKAGE_GOOGLE_SEARCH + ":search";
+    private static final String PACKAGE_GMS = "com.google.android.gms";
+    private static final String PROCESS_GMS_UNSTABLE = PACKAGE_GMS + ".unstable";
+
+    private static final Map<String, String> PIXEL_TABLET_UI_PROPS = Map.of(
+            "PRODUCT", "tangorpro",
+            "DEVICE", "tangorpro",
+            "HARDWARE", "tangorpro",
+            "MANUFACTURER", "Google",
+            "BRAND", "google",
+            "MODEL", "Pixel Tablet");
+
+    private static boolean sApplied;
+
+    private PixelTabletAppProps() {}
+
+    /** Applies the compatibility identity before the app's onCreate callback. */
+    public static void apply(Context context) {
+        if (!DEVICE_TB132FU.equals(SystemProperties.get("ro.product.device"))
+                || !SystemProperties.get("ro.build.characteristics", "")
+                        .contains("tablet")) {
+            return;
+        }
+
+        final String packageName = context.getPackageName();
+        final String processName = Application.getProcessName();
+        if (TextUtils.isEmpty(packageName) || TextUtils.isEmpty(processName)) {
+            return;
+        }
+
+        if (!shouldApply(packageName, processName, Process.isIsolated())) {
+            return;
+        }
+
+        if (sApplied) {
+            return;
+        }
+
+        try {
+            final UnsafeAccess unsafe = UnsafeAccess.create();
+            boolean applied = true;
+            for (Map.Entry<String, String> property : PIXEL_TABLET_UI_PROPS.entrySet()) {
+                applied &= setBuildField(unsafe, property.getKey(), property.getValue());
+            }
+            if (applied) {
+                sApplied = true;
+                Log.i(TAG, "Applied Pixel Tablet UI identity to " + packageName
+                        + " process " + processName);
+            }
+        } catch (ReflectiveOperationException | SecurityException e) {
+            Log.e(TAG, "Unable to obtain framework Unsafe access", e);
+        }
+    }
+
+    /**
+     * Limits the compatibility identity to processes which actually select
+     * Google tablet UI. In particular, do not alter Pixel Launcher (the
+     * dedicated tablet APK and resource configuration already select its
+     * layout) or Search-owned WebView/hotword isolated processes.
+     */
+    static boolean shouldApply(String packageName, String processName, boolean isolated) {
+        if (isolated) {
+            return false;
+        }
+        if (PACKAGE_GOOGLE_SEARCH.equals(packageName)) {
+            return PACKAGE_GOOGLE_SEARCH.equals(processName)
+                    || PROCESS_GOOGLE_SEARCH_APP.equals(processName)
+                    || PROCESS_GOOGLE_SEARCH_SERVICE.equals(processName);
+        }
+        return PACKAGE_GMS.equals(packageName)
+                && processName.startsWith(PACKAGE_GMS)
+                && !PROCESS_GMS_UNSTABLE.equals(processName);
+    }
+
+    private static boolean setBuildField(UnsafeAccess unsafe, String name, String value) {
+        try {
+            final Field field = Build.class.getDeclaredField(name);
+            final Object fieldBase = unsafe.staticFieldBase(field);
+            final long fieldOffset = unsafe.staticFieldOffset(field);
+            unsafe.putReferenceVolatile(fieldBase, fieldOffset, value);
+            if (!value.equals(unsafe.getReferenceVolatile(fieldBase, fieldOffset))) {
+                Log.e(TAG, "Build." + name + " did not retain the requested value");
+                return false;
+            }
+            return true;
+        } catch (ReflectiveOperationException | IllegalArgumentException | SecurityException e) {
+            Log.e(TAG, "Unable to set Build." + name, e);
+            return false;
+        }
+    }
+
+    /** Reflection bridge to the libcore implementation absent from framework compile stubs. */
+    private static final class UnsafeAccess {
+        private static final String CLASS_NAME = "jdk.internal.misc.Unsafe";
+
+        private final Object mUnsafe;
+        private final Method mStaticFieldBase;
+        private final Method mStaticFieldOffset;
+        private final Method mPutReferenceVolatile;
+        private final Method mGetReferenceVolatile;
+
+        private UnsafeAccess(Object unsafe, Method staticFieldBase, Method staticFieldOffset,
+                Method putReferenceVolatile, Method getReferenceVolatile) {
+            mUnsafe = unsafe;
+            mStaticFieldBase = staticFieldBase;
+            mStaticFieldOffset = staticFieldOffset;
+            mPutReferenceVolatile = putReferenceVolatile;
+            mGetReferenceVolatile = getReferenceVolatile;
+        }
+
+        static UnsafeAccess create() throws ReflectiveOperationException {
+            final Class<?> unsafeClass = Class.forName(CLASS_NAME);
+            final Field singleton = unsafeClass.getDeclaredField("theUnsafe");
+            singleton.setAccessible(true);
+            final Object unsafe = singleton.get(null);
+            singleton.setAccessible(false);
+            return new UnsafeAccess(
+                    unsafe,
+                    unsafeClass.getMethod("staticFieldBase", Field.class),
+                    unsafeClass.getMethod("staticFieldOffset", Field.class),
+                    unsafeClass.getMethod(
+                            "putReferenceVolatile", Object.class, long.class, Object.class),
+                    unsafeClass.getMethod("getReferenceVolatile", Object.class, long.class));
+        }
+
+        Object staticFieldBase(Field field) throws ReflectiveOperationException {
+            return mStaticFieldBase.invoke(mUnsafe, field);
+        }
+
+        long staticFieldOffset(Field field) throws ReflectiveOperationException {
+            return (long) mStaticFieldOffset.invoke(mUnsafe, field);
+        }
+
+        void putReferenceVolatile(Object base, long offset, Object value)
+                throws ReflectiveOperationException {
+            mPutReferenceVolatile.invoke(mUnsafe, base, offset, value);
+        }
+
+        Object getReferenceVolatile(Object base, long offset)
+                throws ReflectiveOperationException {
+            return mGetReferenceVolatile.invoke(mUnsafe, base, offset);
+        }
+    }
+}
