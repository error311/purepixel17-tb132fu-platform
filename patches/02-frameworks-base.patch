+
+package com.android.server.power;
+
+import android.content.Context;
+import android.content.Intent;
+import android.os.Handler;
+import android.os.SystemProperties;
+import android.os.UEventObserver;
+import android.os.UserHandle;
+import android.util.Slog;
+
+import com.android.internal.annotations.VisibleForTesting;
+
+/** Relays the TB132FU's CTN730 magnetic pen-charger state to SystemUI. */
+final class Tb132fuPenChargerObserver extends UEventObserver {
+    static final String ACTION_PEN_CHARGER_CHANGED =
+            "com.android.systemui.action.TB132FU_PEN_CHARGER_CHANGED";
+    static final String EXTRA_ATTACHED = "attached";
+    static final String EXTRA_CHARGING_STATE = "charging_state";
+    static final String EXTRA_MAC = "mac";
+    static final String EXTRA_LEVEL = "level";
+
+    private static final String TAG = "Tb132fuPenCharger";
+    private static final String TB132FU_DEVICE = "TB132FU";
+    private static final String CTN730_DEVPATH = "/devices/virtual/misc/ctn730";
+    private static final String SYSTEMUI_PACKAGE = "com.android.systemui";
+
+    private final Context mContext;
+    private final Handler mHandler;
+    private Boolean mLastAttached;
+    private String mLastMac;
+
+    Tb132fuPenChargerObserver(Context context, Handler handler) {
+        mContext = context;
+        mHandler = handler;
+    }
+
+    static Tb132fuPenChargerObserver createIfSupported(Context context, Handler handler) {
+        if (!TB132FU_DEVICE.equalsIgnoreCase(
+                SystemProperties.get("ro.product.vendor.device", ""))) {
+            return null;
+        }
+        return new Tb132fuPenChargerObserver(context, handler);
+    }
+
+    void start() {
+        startObserving("DEVPATH=" + CTN730_DEVPATH);
+        Slog.i(TAG, "Observing the CTN730 magnetic pen charger");
+    }
+
+    @Override
+    public void onUEvent(UEvent event) {
+        final String attachedValue = event.get("ATTACHED");
+        if (attachedValue == null) {
+            return;
+        }
+        final boolean attached = "1".equals(attachedValue);
+        final String chargingState = event.get("CHARGING_STATE");
+        final String mac = event.get("MAC");
+        final int level = parseLevel(event.get("LEVEL"));
+        mHandler.post(() -> dispatchIfChanged(attached, chargingState, mac, level));
+    }
+
+    private void dispatchIfChanged(boolean attached, String chargingState, String mac, int level) {
+        if (mac != null && !mac.isBlank()) {
+            mLastMac = mac;
+        }
+        if (mLastAttached != null && mLastAttached == attached) {
+            return;
+        }
+        mLastAttached = attached;
+
+        final Intent intent = new Intent(ACTION_PEN_CHARGER_CHANGED)
+                .setPackage(SYSTEMUI_PACKAGE)
+                .putExtra(EXTRA_ATTACHED, attached)
+                .putExtra(EXTRA_CHARGING_STATE,
+                        chargingState == null ? "Unknown" : chargingState)
+                .putExtra(EXTRA_LEVEL, level);
+        if (mLastMac != null) {
+            intent.putExtra(EXTRA_MAC, mLastMac);
+        }
+        mContext.sendBroadcastAsUser(intent, UserHandle.ALL);
+        Slog.i(TAG, "Magnetic pen charger changed: attached=" + attached
+                + ", charging=" + chargingState + ", level=" + level);
+    }
+
+    @VisibleForTesting
+    static int parseLevel(String value) {
+        if (value == null) {
+            return -1;
+        }
+        try {
+            final int level = Integer.parseInt(value);
+            return level >= 0 && level <= 100 ? level : -1;
+        } catch (NumberFormatException ignored) {
+            return -1;
+        }
+    }
+}
