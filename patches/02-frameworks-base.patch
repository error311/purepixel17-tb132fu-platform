+                BcSmartspaceDataPlugin.SmartspaceView {
+    private BcSmartspaceDataPlugin mDataProvider;
+    private FalsingManager mFalsingManager;
+    private SmartspaceTarget mTarget;
+    private SmartspaceAction mAction;
