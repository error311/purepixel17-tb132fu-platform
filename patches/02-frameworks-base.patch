+package com.android.internal.util;
+
+import static com.google.common.truth.Truth.assertThat;
+
+import androidx.test.ext.junit.runners.AndroidJUnit4;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+@RunWith(AndroidJUnit4.class)
+public class PixelTabletAppPropsTest {
+    private static final String SEARCH = "com.google.android.googlequicksearchbox";
+    private static final String GMS = "com.google.android.gms";
+
+    @Test
+    public void shouldApply_searchUiProcessesOnly() {
+        assertThat(PixelTabletAppProps.shouldApply(SEARCH, SEARCH, false)).isTrue();
+        assertThat(PixelTabletAppProps.shouldApply(SEARCH, SEARCH + ":googleapp", false)).isTrue();
+        assertThat(PixelTabletAppProps.shouldApply(SEARCH, SEARCH + ":search", false)).isTrue();
+
+        assertThat(PixelTabletAppProps.shouldApply(
+                SEARCH, SEARCH + ":interactor", false)).isFalse();
+        assertThat(PixelTabletAppProps.shouldApply(
+                SEARCH, "com.google.android.webview:sandboxed_process0", true)).isFalse();
+        assertThat(PixelTabletAppProps.shouldApply(
+                SEARCH, SEARCH + ":trusted_disable_art_image_:hotword_detector_0", true))
+                .isFalse();
+    }
+
+    @Test
+    public void shouldApply_nonAttestationGmsOnly() {
+        assertThat(PixelTabletAppProps.shouldApply(GMS, GMS, false)).isTrue();
+        assertThat(PixelTabletAppProps.shouldApply(GMS, GMS + ".persistent", false)).isTrue();
+
+        assertThat(PixelTabletAppProps.shouldApply(GMS, GMS + ".unstable", false)).isFalse();
+        assertThat(PixelTabletAppProps.shouldApply(GMS, GMS + ".persistent", true)).isFalse();
+        assertThat(PixelTabletAppProps.shouldApply(
+                GMS, "com.google.android.webview:sandboxed_process0", false)).isFalse();
+    }
+
+    @Test
+    public void shouldApply_doesNotSpoofLauncherOrOtherPackages() {
+        assertThat(PixelTabletAppProps.shouldApply(
+                "com.google.android.apps.nexuslauncher",
+                "com.google.android.apps.nexuslauncher", false)).isFalse();
+        assertThat(PixelTabletAppProps.shouldApply(
+                "com.android.settings", "com.android.settings", false)).isFalse();
+    }
+}
