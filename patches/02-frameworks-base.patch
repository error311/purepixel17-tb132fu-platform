+
+/** Compact renderer for privacy-filtered non-weather lock-screen Smartspace targets. */
+public final class PurePixelSmartspaceView extends TextView
+        implements BcSmartspaceDataPlugin.SmartspaceTargetListener,
+                BcSmartspaceDataPlugin.SmartspaceView {
+    private BcSmartspaceDataPlugin mDataProvider;
+    private FalsingManager mFalsingManager;
+    private SmartspaceTarget mTarget;
+    private SmartspaceAction mAction;
+    private int mPrimaryTextColor;
+    private float mDozeAmount;
+
+    PurePixelSmartspaceView(Context context) {
+        super(context);
+        setId(com.android.systemui.shared.R.id.bc_smartspace_view);
+        setGravity(Gravity.CENTER_VERTICAL);
+        setSingleLine(true);
+        setEllipsize(TextUtils.TruncateAt.END);
+        setIncludeFontPadding(false);
+        setTextSize(TypedValue.COMPLEX_UNIT_SP, 14);
+        setMinHeight(dp(32));
+        setVisibility(View.GONE);
+        mPrimaryTextColor = context.getColor(android.R.color.white);
+        updateTextColor();
+    }
+
+    @Override
+    protected void onAttachedToWindow() {
+        super.onAttachedToWindow();
+        if (mDataProvider != null) {
+            mDataProvider.registerListener(this);
+        }
+    }
+
+    @Override
+    protected void onDetachedFromWindow() {
+        if (mDataProvider != null) {
+            mDataProvider.unregisterListener(this);
+        }
+        super.onDetachedFromWindow();
+    }
+
+    @Override
+    public void onSmartspaceTargetsUpdated(List<? extends Parcelable> targets) {
+        SmartspaceTarget target = null;
+        for (Parcelable candidate : targets) {
+            if (candidate instanceof SmartspaceTarget) {
+                target = (SmartspaceTarget) candidate;
+                break;
+            }
+        }
+        bindTarget(target);
+    }
+
+    private void bindTarget(SmartspaceTarget target) {
+        mTarget = target;
+        mAction = null;
+        setOnClickListener(null);
+
+        if (target == null) {
+            setText(null);
+            setContentDescription(null);
+            setVisibility(View.GONE);
+            return;
+        }
+
+        CharSequence label = null;
+        mAction = target.getHeaderAction();
+        if (mAction != null) {
+            label = mAction.getTitle();
+        }
+        if (TextUtils.isEmpty(label)) {
+            mAction = target.getBaseAction();
+            if (mAction != null) {
+                label = mAction.getTitle();
+            }
+        }
+        if (TextUtils.isEmpty(label)) {
+            setText(null);
+            setContentDescription(null);
+            setVisibility(View.GONE);
+            return;
+        }
+
+        setText(label);
+        setContentDescription(label);
+        updateTextColor();
+        setVisibility(View.VISIBLE);
+        if (mAction != null) {
+            setOnClickListener(this::openTarget);
+        }
+    }
+
+    private void openTarget(View view) {
+        if (mFalsingManager != null
+                && mFalsingManager.isFalseTap(FalsingManager.LOW_PENALTY)) {
+            return;
+        }
+        if (mDataProvider == null || mTarget == null || mAction == null) {
+            return;
+        }
+        final BcSmartspaceDataPlugin.SmartspaceEventNotifier notifier =
+                mDataProvider.getEventNotifier();
+        final BcSmartspaceDataPlugin.IntentStarter starter =
+                notifier == null ? null : notifier.getIntentStarter();
+        if (starter != null) {
+            starter.startFromAction(mAction, view, false);
+        }
+        if (notifier != null) {
+            final SmartspaceTargetEvent.Builder event = new SmartspaceTargetEvent.Builder(
+                    SmartspaceTargetEvent.EVENT_TARGET_INTERACTION)
+                    .setSmartspaceTarget(mTarget);
+            if (!TextUtils.isEmpty(mAction.getId())) {
+                event.setSmartspaceActionId(mAction.getId());
+            }
+            notifier.notifySmartspaceEvent(event.build());
+        }
+    }
+
+    @Override
+    public void registerDataProvider(BcSmartspaceDataPlugin dataProvider) {
+        if (mDataProvider != null && isAttachedToWindow()) {
+            mDataProvider.unregisterListener(this);
+        }
+        mDataProvider = dataProvider;
+        if (mDataProvider != null && isAttachedToWindow()) {
+            mDataProvider.registerListener(this);
+        }
+    }
+
+    @Override
+    public void setPrimaryTextColor(int color) {
+        mPrimaryTextColor = color;
+        updateTextColor();
+    }
+
+    @Override
+    public void setUiSurface(String uiSurface) {}
+
+    @Override
+    public void setBgHandler(Handler bgHandler) {}
+
+    @Override
+    public void setDozeAmount(float amount) {
+        mDozeAmount = Math.max(0f, Math.min(1f, amount));
+        updateTextColor();
+    }
+
+    @Override
+    public void setFalsingManager(FalsingManager falsingManager) {
+        mFalsingManager = falsingManager;
+    }
+
+    @Override
+    public void setDnd(Drawable image, String description) {}
+
+    @Override
+    public void setNextAlarm(Drawable image, String description) {}
+
+    @Override
+    public int getSelectedPage() {
+        return 0;
+    }
+
+    @Override
+    public int getCurrentCardTopPadding() {
+        return 0;
+    }
+
+    @Override
+    public void setHorizontalPaddings(int horizontalPadding) {
+        setPaddingRelative(horizontalPadding, getPaddingTop(), horizontalPadding,
+                getPaddingBottom());
+    }
+
+    private void updateTextColor() {
+        setTextColor(ColorUtils.blendARGB(mPrimaryTextColor, 0xffffffff, mDozeAmount));
+    }
+
+    private int dp(int value) {
+        return Math.round(value * getResources().getDisplayMetrics().density);
+    }
+}
