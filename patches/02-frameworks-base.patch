@@ -2019,9 +2028,59 @@ public class RecentsTransitionHandler implements Transitions.TransitionHandler,
             // surface to match the leash. Otherwise, there will be a flicker before the
             // visibility gets committed in Core when using split-screen (in splitscreen,
             // the leaf-tasks are not "independent" so aren't hidden by normal setup).
+            if (task == mTb132fuFixedQsbSearchTask) {
+                // Restore the task's persistent parent alpha while it is hidden. A later launch
+                // of Google Search must never inherit the Home-return suppression.
+                finishTransaction.setAlpha(task.mTaskSurface, 1f);
+                mTb132fuFixedQsbSearchTask = null;
+            }
             finishTransaction.hide(task.mTaskSurface);
         }
 
+        private boolean isTb132fuFixedQsbSearchTask(TaskState task) {
+            if (!"tb132fu".equals(Build.DEVICE) || task == null || task.mTaskInfo == null) {
+                return false;
+            }
+            final ComponentName topActivity = task.mTaskInfo.topActivity;
+            return topActivity != null
+                    && "com.google.android.googlequicksearchbox".equals(
+                            topActivity.getPackageName())
+                    && "com.google.android.googlequicksearchbox.InternalGoogleAppActivityEntrypoint"
+                            .equals(topActivity.getClassName());
