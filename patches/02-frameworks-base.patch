+
+package com.android.systemui.stylus
+
+import android.Manifest
+import android.annotation.SuppressLint
+import android.bluetooth.BluetoothDevice
+import android.bluetooth.BluetoothManager
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.content.IntentFilter
+import android.os.Handler
+import android.os.SystemProperties
+import android.util.Log
+import com.android.systemui.CoreStartable
+import com.android.systemui.broadcast.BroadcastDispatcher
+import com.android.systemui.common.shared.model.Icon
+import com.android.systemui.common.shared.model.Text
+import com.android.systemui.common.shared.model.TintedIcon
+import com.android.systemui.dagger.SysUISingleton
+import com.android.systemui.dagger.qualifiers.Main
+import com.android.systemui.res.R
+import com.android.systemui.temporarydisplay.ViewPriority
+import com.android.systemui.temporarydisplay.chipbar.ChipbarCoordinator
+import com.android.systemui.temporarydisplay.chipbar.ChipbarInfo
+import javax.inject.Inject
+
+/** Shows the TB132FU pen-charging chip and bridges CTN730 state to Lenovo PenService. */
+@SysUISingleton
+class Tb132fuPenChargerStartable
+@Inject
+constructor(
+    private val context: Context,
+    private val broadcastDispatcher: BroadcastDispatcher,
+    private val chipbarCoordinator: ChipbarCoordinator,
+    @Main private val mainHandler: Handler,
+) : CoreStartable, BroadcastReceiver() {
+
+    private var syncedPenMac: String? = null
+
+    override fun start() {
+        if (!isTb132fu()) return
+
+        broadcastDispatcher.registerReceiver(
+            receiver = this,
+            filter = IntentFilter(ACTION_PEN_CHARGER_CHANGED),
+            flags = Context.RECEIVER_EXPORTED,
+            permission = Manifest.permission.STATUS_BAR_SERVICE,
+        )
+        Log.i(TAG, "TB132FU magnetic pen-charger UI enabled")
+    }
+
+    override fun onReceive(receiverContext: Context?, intent: Intent?) {
+        if (intent?.action != ACTION_PEN_CHARGER_CHANGED) return
+
+        val attached = intent.getBooleanExtra(EXTRA_ATTACHED, false)
+        val mac = intent.getStringExtra(EXTRA_MAC)?.takeIf { it.isNotBlank() }
+        val eventLevel = intent.getIntExtra(EXTRA_LEVEL, BluetoothDevice.BATTERY_LEVEL_UNKNOWN)
+        if (!attached) {
+            relayBatteryToLenovoPenService(mac, eventLevel, attached = false)
+            return
+        }
+
+        val level = resolveBatteryLevel(mac, eventLevel)
+        if (level != BluetoothDevice.BATTERY_LEVEL_UNKNOWN) {
+            showChargingChip(level)
+            relayBatteryToLenovoPenService(mac, level, attached = true)
+            return
+        }
+
+        // The CTN730 attach uevent can arrive just before Bluetooth publishes its battery cache.
+        mainHandler.postDelayed(
+            {
+                val delayedLevel = resolveBatteryLevel(mac, eventLevel)
+                showChargingChip(delayedLevel)
+                relayBatteryToLenovoPenService(mac, delayedLevel, attached = true)
+            },
+            BATTERY_RETRY_DELAY_MS,
+        )
+    }
+
+    private fun showChargingChip(level: Int) {
+        val message =
+            if (level in 0..100) {
+                context.getString(R.string.tb132fu_pen_charging_level, level)
+            } else {
+                context.getString(R.string.tb132fu_pen_charging)
+            }
+        chipbarCoordinator.displayView(
+            ChipbarInfo(
+                startIcon =
+                    TintedIcon(
+                        Icon.Resource(R.drawable.ic_tb132fu_precision_pen, null),
+                        ChipbarInfo.DEFAULT_ICON_TINT,
+                    ),
+                text = Text.Loaded(message),
+                endItem = null,
+                vibrationEffect = null,
+                allowSwipeToDismiss = true,
+                windowTitle = context.getString(R.string.tb132fu_pen_charging_window_title),
+                wakeReason = "TB132FU_PEN_CHARGER_ATTACHED",
+                timeoutMs = CHIP_TIMEOUT_MS,
+                id = CHIP_ID,
+                priority = ViewPriority.NORMAL,
+                instanceId = null,
+            )
+        )
+        Log.i(TAG, "Displayed magnetic pen charging chip; level=$level")
+    }
+
+    @SuppressLint("MissingPermission")
+    private fun resolveBatteryLevel(mac: String?, eventLevel: Int): Int {
+        if (eventLevel in 0..100) return eventLevel
+        if (mac == null) return BluetoothDevice.BATTERY_LEVEL_UNKNOWN
+        return try {
+            val adapter = context.getSystemService(BluetoothManager::class.java)?.adapter
+            adapter?.getRemoteDevice(mac)?.batteryLevel ?: BluetoothDevice.BATTERY_LEVEL_UNKNOWN
+        } catch (exception: IllegalArgumentException) {
+            Log.w(TAG, "CTN730 supplied an invalid pen address", exception)
+            BluetoothDevice.BATTERY_LEVEL_UNKNOWN
+        }
+    }
+
+    private fun relayBatteryToLenovoPenService(mac: String?, level: Int, attached: Boolean) {
+        if (mac == null) return
+        if (syncedPenMac != mac) {
+            context.sendBroadcast(
+                Intent(ACTION_LENOVO_PEN_BT_CHANGED)
+                    .setPackage(LENOVO_PEN_SERVICE_PACKAGE)
+                    .putExtra("status", 1)
+                    .putExtra("address", mac)
+                    .putExtra("attached", if (attached) 1 else 0)
+                    .putExtra("isfirstpair", false)
+                    .putExtra("attached_mac", mac)
+            )
+            syncedPenMac = mac
+        }
+        if (level !in 0..100) return
+        context.sendBroadcast(
+            Intent(ACTION_LENOVO_PEN_BATTERY_CHANGED)
+                .setPackage(LENOVO_PEN_SERVICE_PACKAGE)
+                .putExtra("address", mac)
+                .putExtra("level", level)
+                .putExtra("charging_state", if (attached) 1 else 2)
+                .putExtra("attached", if (attached) 1 else 0)
+                .putExtra("attached_mac", mac)
+                .putExtra("source", 0)
+        )
+    }
+
+    private fun isTb132fu(): Boolean =
+        SystemProperties.get("ro.product.vendor.device", "").equals("TB132FU", ignoreCase = true)
+
+    companion object {
+        private const val TAG = "Tb132fuPenCharger"
+        private const val ACTION_PEN_CHARGER_CHANGED =
+            "com.android.systemui.action.TB132FU_PEN_CHARGER_CHANGED"
+        private const val ACTION_LENOVO_PEN_BT_CHANGED = "com.zui.udevice.action.PEN_BT_CHANGED"
+        private const val ACTION_LENOVO_PEN_BATTERY_CHANGED =
+            "com.zui.udevice.action.PEN_BATTERY_CHANGED"
+        private const val LENOVO_PEN_SERVICE_PACKAGE = "com.lenovo.penservice"
+        private const val EXTRA_ATTACHED = "attached"
+        private const val EXTRA_MAC = "mac"
+        private const val EXTRA_LEVEL = "level"
+        private const val CHIP_ID = "tb132fu_pen_charging"
+        private const val CHIP_TIMEOUT_MS = 5000
+        private const val BATTERY_RETRY_DELAY_MS = 600L
+    }
+}
