+        }
+    }
+
+    @Override
+    protected void onDetachedFromWindow() {
+        if (mDataProvider != null) {
+            mDataProvider.unregisterListener(this);
+        }
+        super.onDetachedFromWindow();
+    }
+
+    @Override
+    public void onSmartspaceTargetsUpdated(List<? extends Parcelable> targets) {
+        SmartspaceTarget weather = null;
+        for (Parcelable candidate : targets) {
+            if (candidate instanceof SmartspaceTarget
+                    && ((SmartspaceTarget) candidate).getFeatureType()
+                            == SmartspaceTarget.FEATURE_WEATHER) {
+                weather = (SmartspaceTarget) candidate;
+                break;
+            }
+        }
+        bindTarget(weather);
+    }
+
+    private void bindTarget(SmartspaceTarget target) {
+        mTarget = target;
+        mTapAction = null;
+        mHeaderAction = null;
+        mTintIcon = false;
+        setOnClickListener(null);
+        setCompoundDrawablesRelative(null, null, null, null);
+
+        if (target == null) {
+            setText(null);
+            setContentDescription(null);
+            setVisibility(View.GONE);
+            return;
+        }
+
+        CharSequence label = null;
+        CharSequence iconDescription = null;
+        Drawable icon = null;
+        final BaseTemplateData template = target.getTemplateData();
+        final BaseTemplateData.SubItemInfo subtitle =
+                template == null ? null : template.getSubtitleItem();
+        if (subtitle != null) {
+            if (subtitle.getText() != null) {
+                label = subtitle.getText().getText();
+            }
+            if (subtitle.getIcon() != null) {
+                icon = subtitle.getIcon().getIcon().loadDrawable(getContext());
+                iconDescription = subtitle.getIcon().getContentDescription();
+                mTintIcon = subtitle.getIcon().shouldTint();
+            }
+            mTapAction = subtitle.getTapAction();
+        }
+
+        mHeaderAction = target.getHeaderAction();
+        if (TextUtils.isEmpty(label) && mHeaderAction != null) {
+            label = mHeaderAction.getTitle();
+        }
+        if (icon == null && mHeaderAction != null && mHeaderAction.getIcon() != null) {
+            icon = mHeaderAction.getIcon().loadDrawable(getContext());
+            iconDescription = mHeaderAction.getContentDescription();
+        }
+
+        if (TextUtils.isEmpty(label)) {
+            setText(null);
+            setContentDescription(null);
+            setVisibility(View.GONE);
+            return;
+        }
+
+        setText(label);
+        setContentDescription(TextUtils.isEmpty(iconDescription)
+                ? label : TextUtils.concat(label, ", ", iconDescription));
+        if (icon != null) {
+            final int size = dp(ICON_SIZE_DP);
+            icon.setBounds(0, 0, size, size);
+            setCompoundDrawablesRelative(icon, null, null, null);
+        }
+        updateTextAndIconColor();
+        setVisibility(View.VISIBLE);
+        if (mTapAction != null || mHeaderAction != null) {
+            setOnClickListener(this::openTarget);
+        }
+    }
+
+    private void openTarget(View view) {
+        if (mFalsingManager != null
+                && mFalsingManager.isFalseTap(FalsingManager.LOW_PENALTY)) {
+            return;
+        }
+        if (mDataProvider == null || mTarget == null) {
+            return;
+        }
+        final BcSmartspaceDataPlugin.SmartspaceEventNotifier notifier =
+                mDataProvider.getEventNotifier();
+        final BcSmartspaceDataPlugin.IntentStarter starter =
+                notifier == null ? null : notifier.getIntentStarter();
+        String actionId = null;
+        if (starter != null && mTapAction != null) {
+            starter.startFromAction(mTapAction, view, mTapAction.shouldShowOnLockscreen());
+            actionId = mTapAction.getId() == null ? null : mTapAction.getId().toString();
+        } else if (starter != null && mHeaderAction != null) {
+            starter.startFromAction(mHeaderAction, view, false);
+            actionId = mHeaderAction.getId();
+        }
+        if (notifier != null) {
+            final SmartspaceTargetEvent.Builder event = new SmartspaceTargetEvent.Builder(
+                    SmartspaceTargetEvent.EVENT_TARGET_INTERACTION)
+                    .setSmartspaceTarget(mTarget);
+            if (!TextUtils.isEmpty(actionId)) {
+                event.setSmartspaceActionId(actionId);
+            }
+            notifier.notifySmartspaceEvent(event.build());
+        }
+    }
+
+    @Override
+    public void registerDataProvider(BcSmartspaceDataPlugin dataProvider) {
+        if (mDataProvider != null && isAttachedToWindow()) {
+            mDataProvider.unregisterListener(this);
+        }
+        mDataProvider = dataProvider;
+        if (mDataProvider != null && isAttachedToWindow()) {
+            mDataProvider.registerListener(this);
+        }
+    }
+
+    @Override
+    public void setPrimaryTextColor(int color) {
+        mPrimaryTextColor = color;
+        updateTextAndIconColor();
+    }
+
+    @Override
+    public void setUiSurface(String uiSurface) {
+        // This renderer is intentionally valid only for the controller's lockscreen/AOD surface.
+    }
+
+    @Override
+    public void setBgHandler(Handler bgHandler) {
+        // No binder or settings work is performed by the view itself.
+    }
+
+    @Override
+    public void setDozeAmount(float amount) {
+        mDozeAmount = Math.max(0f, Math.min(1f, amount));
+        updateTextAndIconColor();
+    }
+
+    @Override
+    public void setFalsingManager(FalsingManager falsingManager) {
+        mFalsingManager = falsingManager;
+    }
+
+    private void updateTextAndIconColor() {
+        final int color = ColorUtils.blendARGB(mPrimaryTextColor, 0xffffffff, mDozeAmount);
+        setTextColor(color);
+        final Drawable icon = getCompoundDrawablesRelative()[0];
+        if (icon != null && mTintIcon) {
+            icon.setTint(color);
+        }
+    }
+
+    private int dp(int value) {
+        return Math.round(value * getResources().getDisplayMetrics().density);
+    }
+}
