diff --git a/services/tests/servicestests/src/com/android/server/power/Tb132fuAmbientControllerTest.java b/services/tests/servicestests/src/com/android/server/power/Tb132fuAmbientControllerTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..08ef93b94c8a8fd3213eb910688f0cf2f3c14e4d
--- /dev/null
+++ b/services/tests/servicestests/src/com/android/server/power/Tb132fuAmbientControllerTest.java
@@ -0,0 +1,85 @@
+/*
+ * Copyright (C) 2026 The Android Open Source Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.server.power;
+
+import static com.google.common.truth.Truth.assertThat;
+
+import org.junit.Test;
+
+import java.time.LocalTime;
+import java.time.ZoneId;
+import java.time.ZonedDateTime;
+
+public final class Tb132fuAmbientControllerTest {
+    @Test
+    public void schedule_suppressesOnlyAtNight() {
+        assertThat(Tb132fuAmbientController.shouldSuppressAod(true, true)).isTrue();
+        assertThat(Tb132fuAmbientController.shouldSuppressAod(true, false)).isFalse();
+        assertThat(Tb132fuAmbientController.shouldSuppressAod(false, true)).isFalse();
+    }
+
+    @Test
+    public void fallbackNight_startsAtNineteenHundred() {
+        assertThat(Tb132fuAmbientController.isFallbackNight(LocalTime.of(18, 59))).isFalse();
+        assertThat(Tb132fuAmbientController.isFallbackNight(LocalTime.of(19, 0))).isTrue();
+    }
+
+    @Test
+    public void fallbackNight_endsAtSevenHundred() {
+        assertThat(Tb132fuAmbientController.isFallbackNight(LocalTime.of(6, 59))).isTrue();
+        assertThat(Tb132fuAmbientController.isFallbackNight(LocalTime.of(7, 0))).isFalse();
+    }
+
+    @Test
+    public void fallbackNight_spansMidnight() {
+        assertThat(Tb132fuAmbientController.isFallbackNight(LocalTime.MIDNIGHT)).isTrue();
+        assertThat(Tb132fuAmbientController.isFallbackNight(LocalTime.NOON)).isFalse();
+    }
+
+    @Test
+    public void nextFallbackTransition_beforeMorning_isMorning() {
+        final ZonedDateTime now = timeAt(6, 59);
+
+        assertThat(Tb132fuAmbientController.nextFallbackTransition(now))
+                .isEqualTo(timeAt(7, 0));
+    }
+
+    @Test
+    public void nextFallbackTransition_atMorning_isEvening() {
+        final ZonedDateTime now = timeAt(7, 0);
+
+        assertThat(Tb132fuAmbientController.nextFallbackTransition(now))
+                .isEqualTo(timeAt(19, 0));
+    }
+
+    @Test
+    public void nextFallbackTransition_duringDay_isEvening() {
+        final ZonedDateTime now = timeAt(12, 0);
+
+        assertThat(Tb132fuAmbientController.nextFallbackTransition(now))
+                .isEqualTo(timeAt(19, 0));
+    }
+
+    @Test
+    public void nextFallbackTransition_afterEvening_isNextMorning() {
+        final ZonedDateTime now = timeAt(19, 0);
+
+        assertThat(Tb132fuAmbientController.nextFallbackTransition(now))
+                .isEqualTo(timeAt(7, 0).plusDays(1));
+    }
+
+    @Test
+    public void nextFallbackTransition_preservesLocalTimeZone() {
+        final ZoneId zone = ZoneId.of("America/New_York");
+        final ZonedDateTime now = ZonedDateTime.of(2026, 3, 8, 12, 0, 0, 0, zone);
+
+        assertThat(Tb132fuAmbientController.nextFallbackTransition(now))
+                .isEqualTo(ZonedDateTime.of(2026, 3, 8, 19, 0, 0, 0, zone));
+    }
+
+    private static ZonedDateTime timeAt(int hour, int minute) {
+        return ZonedDateTime.of(2026, 8, 17, hour, minute, 0, 0, ZoneId.of("UTC"));
+    }
+}
