+        private void setTb132fuFixedQsbSearchSuppressed(boolean suppressed) {
+            if (!"tb132fu".equals(Build.DEVICE)) {
+                return;
+            }
+            if (suppressed) {
+                if (mTb132fuFixedQsbSearchTask != null || mPausingTasks == null) {
+                    return;
+                }
+                for (int i = mPausingTasks.size() - 1; i >= 0; --i) {
+                    final TaskState task = mPausingTasks.get(i);
+                    if (!isTb132fuFixedQsbSearchTask(task)
+                            || task.mTaskSurface == null
+                            || !task.mTaskSurface.isValid()) {
+                        continue;
+                    }
+                    mTb132fuFixedQsbSearchTask = task;
+                    new SurfaceControl.Transaction()
+                            .setAlpha(task.mTaskSurface, 0f)
+                            .apply();
+                    return;
+                }
+            } else if (mTb132fuFixedQsbSearchTask != null) {
+                final TaskState task = mTb132fuFixedQsbSearchTask;
+                mTb132fuFixedQsbSearchTask = null;
+                if (task.mTaskSurface != null && task.mTaskSurface.isValid()) {
+                    new SurfaceControl.Transaction()
+                            .setAlpha(task.mTaskSurface, 1f)
+                            .apply();
+                }
+            }
+        }
