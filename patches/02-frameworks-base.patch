         private IBinder mTransition = null;
         private boolean mKeyguardLocked = false;
         private boolean mWillFinishToHome = false;
+
+        // The TB132FU Pixel Launcher fixed QSB supplies its own floating widget owner during the
+        // Gesture Home return. Keep the Google Search task's parent surface hidden after Home is
+        // selected so it cannot render a second complete QSB behind that owner. This lives in
+        // open WMShell code so the Google-signed Launcher APK remains untouched.
+        @Nullable
+        private TaskState mTb132fuFixedQsbSearchTask;
         private Transitions.TransitionHandler mTakeoverHandler = null;
 
