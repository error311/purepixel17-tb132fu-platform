+import java.util.concurrent.CopyOnWriteArraySet;
+
+/**
+ * AOSP-compatible owner for the lock-screen Smartspace session.
+ *
+ * <p>AOSP's controller does not create a session unless an unqualified main plugin is present.
+ * Weather is rendered by the separately named weather plugin; this provider retains and renders
+ * the already privacy-filtered non-weather targets delivered by the controller.</p>
+ */
+public final class PurePixelSmartspaceDataProvider implements BcSmartspaceDataPlugin {
+    private final Set<SmartspaceTargetListener> mListeners = new CopyOnWriteArraySet<>();
+    private final List<SmartspaceTarget> mTargets = new ArrayList<>();
+    private final EventNotifier mEventNotifier = new EventNotifier();
+
+    @Override
+    public SmartspaceView getView(Context context) {
+        return new PurePixelSmartspaceView(context);
+    }
+
+    @Override
+    public SmartspaceView getLargeClockView(Context context) {
+        return new PurePixelSmartspaceView(context);
+    }
+
+    @Override
+    public void registerListener(SmartspaceTargetListener listener) {
+        mListeners.add(listener);
+        listener.onSmartspaceTargetsUpdated(List.copyOf(mTargets));
+    }
+
+    @Override
+    public void unregisterListener(SmartspaceTargetListener listener) {
+        mListeners.remove(listener);
+    }
+
+    @Override
+    public void onTargetsAvailable(List<SmartspaceTarget> targets) {
+        mTargets.clear();
+        mTargets.addAll(targets);
+        final List<SmartspaceTarget> snapshot = List.copyOf(mTargets);
+        for (SmartspaceTargetListener listener : mListeners) {
+            listener.onSmartspaceTargetsUpdated(snapshot);
+        }
+    }
+
+    @Override
+    public void setEventDispatcher(SmartspaceEventDispatcher eventDispatcher) {
+        mEventNotifier.mDispatcher = eventDispatcher;
+    }
+
+    @Override
+    public void setIntentStarter(IntentStarter intentStarter) {
+        mEventNotifier.mIntentStarter = intentStarter;
+    }
+
+    @Override
+    public SmartspaceEventNotifier getEventNotifier() {
+        return mEventNotifier;
+    }
+
+    private static final class EventNotifier implements SmartspaceEventNotifier {
+        private SmartspaceEventDispatcher mDispatcher;
+        private IntentStarter mIntentStarter;
+
+        @Override
+        public IntentStarter getIntentStarter() {
+            return mIntentStarter;
+        }
+
+        @Override
+        public void notifySmartspaceEvent(SmartspaceTargetEvent event) {
+            if (mDispatcher != null) {
+                mDispatcher.notifySmartspaceEvent(event);
+            }
+        }
+    }
+}
