+import com.android.systemui.plugins.FalsingManager;
+
+import java.util.Locale;
+
+/** Date row used by the AOSP keyguard blueprint as the parent of the weather renderer. */
+public final class PurePixelDateSmartspaceView extends LinearLayout
+        implements BcSmartspaceDataPlugin.SmartspaceView {
+    private static final int WEATHER_GAP_DP = 8;
+
+    private final TextClock mDateView;
+    private int mPrimaryTextColor;
+    private float mDozeAmount;
+
+    PurePixelDateSmartspaceView(Context context, boolean largeClock) {
+        super(context);
+        setId(largeClock
+                ? com.android.systemui.shared.R.id.date_smartspace_view_large
+                : com.android.systemui.shared.R.id.date_smartspace_view);
+        setOrientation(HORIZONTAL);
+        setGravity(Gravity.CENTER_VERTICAL);
+        setMinimumHeight(dp(32));
+
+        mDateView = new TextClock(context);
+        mDateView.setIncludeFontPadding(false);
+        mDateView.setSingleLine(true);
+        mDateView.setTextSize(TypedValue.COMPLEX_UNIT_SP, largeClock ? 16 : 14);
+        final String pattern = DateFormat.getBestDateTimePattern(
+                Locale.getDefault(), "EEE, MMM d");
+        mDateView.setFormat12Hour(pattern);
+        mDateView.setFormat24Hour(pattern);
+        mDateView.setPaddingRelative(0, 0, dp(WEATHER_GAP_DP), 0);
+        addView(mDateView, new LayoutParams(LayoutParams.WRAP_CONTENT, LayoutParams.WRAP_CONTENT));
+
+        mPrimaryTextColor = context.getColor(android.R.color.white);
+        updateTextColor();
+    }
+
+    @Override
+    public void registerDataProvider(BcSmartspaceDataPlugin dataProvider) {
+        // Date is generated locally; Smartspace supplies the weather sibling in this container.
+    }
+
+    @Override
+    public void setPrimaryTextColor(int color) {
+        mPrimaryTextColor = color;
+        updateTextColor();
+    }
+
+    @Override
+    public void setUiSurface(String uiSurface) {}
+
+    @Override
+    public void setBgHandler(Handler bgHandler) {}
+
+    @Override
+    public void setDozeAmount(float amount) {
+        mDozeAmount = Math.max(0f, Math.min(1f, amount));
+        updateTextColor();
+    }
+
+    @Override
+    public void setFalsingManager(FalsingManager falsingManager) {}
+
+    @Override
+    public void setDnd(Drawable image, String description) {
+        // DND is already represented by the dedicated keyguard status area on this build.
+    }
+
+    @Override
+    public void setNextAlarm(Drawable image, String description) {
+        // Alarm is already represented by the dedicated keyguard status area on this build.
+    }
+
+    private void updateTextColor() {
+        mDateView.setTextColor(ColorUtils.blendARGB(
+                mPrimaryTextColor, 0xffffffff, mDozeAmount));
+    }
+
+    private int dp(int value) {
+        return Math.round(value * getResources().getDisplayMetrics().density);
+    }
+}
