     private int getLidBehavior() {
+        // The TB132FU keyboard cover reports a standards-compliant SW_LID
+        // switch. Lenovo's inherited global default is NONE, which wakes on
+        // open but leaves both the display and AOD running after close. Treat
+        // the physical cover as a real lid and use Android's NO_DOZE close
+        // path; scope this behavior to the exact vendor device identity.
+        if ("TB132FU".equalsIgnoreCase(
+                SystemProperties.get("ro.product.vendor.device", ""))) {
+            return LID_BEHAVIOR_SLEEP;
+        }
         return Settings.Global.getInt(mContext.getContentResolver(),
                 Settings.Global.LID_BEHAVIOR, LID_BEHAVIOR_NONE);
     }
