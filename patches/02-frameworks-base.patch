+        super.onAttachedToWindow();
+        if (mDataProvider != null) {
+            mDataProvider.registerListener(this);
+        }
+    }
+
+    @Override
+    protected void onDetachedFromWindow() {
+        if (mDataProvider != null) {
+            mDataProvider.unregisterListener(this);
+        }
+        super.onDetachedFromWindow();
+    }
+
+    @Override
+    public void onSmartspaceTargetsUpdated(List<? extends Parcelable> targets) {
+        SmartspaceTarget target = null;
+        for (Parcelable candidate : targets) {
+            if (candidate instanceof SmartspaceTarget) {
+                target = (SmartspaceTarget) candidate;
+                break;
+            }
+        }
+        bindTarget(target);
+    }
+
+    private void bindTarget(SmartspaceTarget target) {
+        mTarget = target;
+        mAction = null;
+        setOnClickListener(null);
+
+        if (target == null) {
+            setText(null);
+            setContentDescription(null);
+            setVisibility(View.GONE);
+            return;
+        }
+
+        CharSequence label = null;
+        mAction = target.getHeaderAction();
+        if (mAction != null) {
+            label = mAction.getTitle();
+        }
+        if (TextUtils.isEmpty(label)) {
+            mAction = target.getBaseAction();
+            if (mAction != null) {
+                label = mAction.getTitle();
+            }
+        }
+        if (TextUtils.isEmpty(label)) {
+            setText(null);
+            setContentDescription(null);
+            setVisibility(View.GONE);
+            return;
+        }
+
+        setText(label);
+        setContentDescription(label);
+        updateTextColor();
+        setVisibility(View.VISIBLE);
+        if (mAction != null) {
+            setOnClickListener(this::openTarget);
+        }
+    }
+
+    private void openTarget(View view) {
+        if (mFalsingManager != null
