+
+internal data class PowerButtonLocation(val edge: Int, val x: Float, val y: Float)
+
+/**
+ * Maps a power button from the display's natural orientation into the current rotation.
+ *
+ * [position] is measured from the natural display's left edge for top/bottom buttons and from its
+ * top edge for left/right buttons. Keeping the physical edge explicit supports landscape-first
+ * tablets whose power button is not on the right edge assumed by the original phone-only effect.
+ */
+internal fun getPowerButtonLocation(
+    viewWidth: Int,
+    viewHeight: Int,
+    @Rotation rotation: Int,
+    position: Float,
+    edge: Int,
+): PowerButtonLocation {
+    val naturalWidth = if (rotation % 2 == 0) viewWidth else viewHeight
+    val naturalHeight = if (rotation % 2 == 0) viewHeight else viewWidth
+    val baseEdge =
+        if (edge in POWER_BUTTON_EDGE_TOP..POWER_BUTTON_EDGE_LEFT) {
+            edge
+        } else {
+            POWER_BUTTON_EDGE_RIGHT
+        }
+    val baseX =
+        when (baseEdge) {
+            POWER_BUTTON_EDGE_TOP,
+            POWER_BUTTON_EDGE_BOTTOM -> position
+            POWER_BUTTON_EDGE_RIGHT -> naturalWidth.toFloat()
+            else -> 0f
+        }
+    val baseY =
+        when (baseEdge) {
+            POWER_BUTTON_EDGE_LEFT,
+            POWER_BUTTON_EDGE_RIGHT -> position
+            POWER_BUTTON_EDGE_BOTTOM -> naturalHeight.toFloat()
+            else -> 0f
+        }
+    val (x, y) =
+        when (rotation) {
+            RotationUtils.ROTATION_LANDSCAPE -> Pair(baseY, naturalWidth - baseX)
+            RotationUtils.ROTATION_UPSIDE_DOWN -> Pair(naturalWidth - baseX, naturalHeight - baseY)
+            RotationUtils.ROTATION_SEASCAPE -> Pair(naturalHeight - baseY, baseX)
+            else -> Pair(baseX, baseY)
+        }
+    return PowerButtonLocation((baseEdge - rotation + 4) % 4, x, y)
