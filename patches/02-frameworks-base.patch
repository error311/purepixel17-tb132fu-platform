+package com.android.server.power;
+
+import android.app.ActivityManager;
+import android.app.AlarmManager;
+import android.content.BroadcastReceiver;
+import android.content.ContentResolver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.database.ContentObserver;
+import android.os.Flags;
+import android.os.Handler;
+import android.os.PowerManager;
+import android.os.Process;
+import android.os.SystemProperties;
+import android.os.UserHandle;
+import android.provider.Settings;
+import android.ravenwood.annotation.RavenwoodKeepWholeClass;
+import android.util.Slog;
+
+import com.android.server.LocalServices;
+import com.android.server.twilight.TwilightListener;
+import com.android.server.twilight.TwilightManager;
+import com.android.server.twilight.TwilightState;
+
+import java.time.LocalTime;
+import java.time.ZonedDateTime;
+import java.util.concurrent.Executor;
+
+/** Device-scoped always-on-display policy for the Lenovo TB132FU. */
+@RavenwoodKeepWholeClass
+final class Tb132fuAmbientController implements TwilightListener {
+    private static final String TAG = "Tb132fuAmbient";
+    private static final String DEVICE = "TB132FU";
+    private static final String SETTING_AOD_TWILIGHT_SCHEDULE =
+            "tb132fu_aod_twilight_schedule";
+    private static final String SUPPRESSION_TOKEN = "tb132fu-aod-nighttime";
+
+    // A deterministic local-time fallback keeps nighttime AOD off when no last
+    // known location is available to Android's twilight service.
+    private static final int FALLBACK_NIGHT_START_HOUR = 19;
+    private static final int FALLBACK_NIGHT_END_HOUR = 7;
+
+    private final Context mContext;
+    private final Handler mHandler;
+    private final AmbientDisplaySuppressionController mSuppressionController;
+    private final ContentObserver mSettingsObserver;
+    private final AlarmManager.OnAlarmListener mFallbackAlarmListener;
+    private final BroadcastReceiver mTimeChangedReceiver;
+    private final Executor mHandlerExecutor;
+
+    private AlarmManager mAlarmManager;
+    private TwilightManager mTwilightManager;
+    private boolean mTwilightListening;
+    private boolean mScheduleEnabled;
+    private boolean mScheduleSuppressed;
+
+    static Tb132fuAmbientController createIfSupported(Context context, Handler handler,
+            AmbientDisplaySuppressionController suppressionController) {
+        if (!DEVICE.equalsIgnoreCase(
+                SystemProperties.get("ro.product.vendor.device", ""))) {
+            return null;
+        }
+        return new Tb132fuAmbientController(context, handler, suppressionController);
+    }
+
+    private Tb132fuAmbientController(Context context, Handler handler,
+            AmbientDisplaySuppressionController suppressionController) {
+        mContext = context;
+        mHandler = handler;
+        mHandlerExecutor = handler::post;
+        mSuppressionController = suppressionController;
+        mFallbackAlarmListener = this::updateFromCurrentTwilightState;
+        mTimeChangedReceiver = new BroadcastReceiver() {
+            @Override
+            public void onReceive(Context context, Intent intent) {
+                updateFromCurrentTwilightState();
+            }
+        };
+        mSettingsObserver = new ContentObserver(handler) {
+            @Override
+            public void onChange(boolean selfChange) {
+                updateSettings();
+            }
+        };
+    }
+
+    void systemReady() {
+        final ContentResolver resolver = mContext.getContentResolver();
+        resolver.registerContentObserver(Settings.Secure.getUriFor(
+                        SETTING_AOD_TWILIGHT_SCHEDULE), false, mSettingsObserver,
+                UserHandle.USER_ALL);
+        final IntentFilter timeChangedFilter = new IntentFilter();
+        timeChangedFilter.addAction(Intent.ACTION_TIME_CHANGED);
+        timeChangedFilter.addAction(Intent.ACTION_TIMEZONE_CHANGED);
+        mContext.registerReceiver(mTimeChangedReceiver, timeChangedFilter, null, mHandler,
+                Context.RECEIVER_NOT_EXPORTED);
+        mAlarmManager = mContext.getSystemService(AlarmManager.class);
+        mTwilightManager = LocalServices.getService(TwilightManager.class);
+        if (mTwilightManager == null) {
+            Slog.w(TAG, "Twilight service unavailable; using local-time fallback");
+        }
+        updateSettings();
+    }
+
+    void onUserChanged() {
+        updateSettings();
+    }
+
+    private void updateSettings() {
+        final boolean enabled = Settings.Secure.getIntForUser(
+                mContext.getContentResolver(), SETTING_AOD_TWILIGHT_SCHEDULE, 1,
+                ActivityManager.getCurrentUser()) != 0;
+        mScheduleEnabled = enabled;
+
+        if (mTwilightManager != null && enabled && !mTwilightListening) {
+            mTwilightManager.registerListener(this, mHandler);
+            mTwilightListening = true;
+        } else if (mTwilightManager != null && !enabled && mTwilightListening) {
+            mTwilightManager.unregisterListener(this);
+            mTwilightListening = false;
+        }
+
+        updateFromCurrentTwilightState();
+    }
+
+    @Override
+    public void onTwilightStateChanged(TwilightState state) {
+        updateSuppression(state);
+    }
+
+    private void updateSuppression(TwilightState state) {
+        final boolean isNight = state != null ? state.isNight() : isFallbackNight();
+        final boolean suppressForSchedule = shouldSuppressAod(mScheduleEnabled, isNight);
+        updateFallbackAlarm(mScheduleEnabled && state == null);
+        if (suppressForSchedule == mScheduleSuppressed) {
+            return;
+        }
+        mScheduleSuppressed = suppressForSchedule;
+
+        if (Flags.lowLightDreamBehavior()) {
+            mSuppressionController.suppress(SUPPRESSION_TOKEN, Process.SYSTEM_UID,
+                    suppressForSchedule ? PowerManager.FLAG_AMBIENT_SUPPRESSION_AOD
+                            : PowerManager.FLAG_AMBIENT_SUPPRESSION_NONE);
+        } else {
+            mSuppressionController.suppress(
+                    SUPPRESSION_TOKEN, Process.SYSTEM_UID, suppressForSchedule);
+        }
+        Slog.i(TAG, suppressForSchedule
+                ? "AOD suppressed overnight"
+                : "AOD allowed during daytime schedule");
+    }
+
+    private void updateFromCurrentTwilightState() {
+        updateSuppression(mTwilightManager == null
+                ? null : mTwilightManager.getLastTwilightState());
+    }
+
+    private void updateFallbackAlarm(boolean enabled) {
+        if (mAlarmManager == null) {
+            return;
+        }
+        mAlarmManager.cancel(mFallbackAlarmListener);
+        if (!enabled) {
+            return;
+        }
+        // The tablet can remain in device idle across a fallback boundary. This policy changes
+        // visible AOD state only twice per day, so wake exactly at the boundary rather than
+        // retaining the old suppression state until an unrelated wake or maintenance window.
+        mAlarmManager.setExactAndAllowWhileIdle(AlarmManager.RTC_WAKEUP,
+                nextFallbackTransition(ZonedDateTime.now()).toInstant().toEpochMilli(),
+                TAG, mHandlerExecutor, null, mFallbackAlarmListener);
+    }
+
+    static boolean shouldSuppressAod(boolean scheduleEnabled, boolean isNight) {
+        return scheduleEnabled && isNight;
+    }
+
+    private static boolean isFallbackNight() {
+        return isFallbackNight(LocalTime.now());
+    }
+
+    static boolean isFallbackNight(LocalTime time) {
+        final int hour = time.getHour();
+        return hour >= FALLBACK_NIGHT_START_HOUR || hour < FALLBACK_NIGHT_END_HOUR;
+    }
+
+    static ZonedDateTime nextFallbackTransition(ZonedDateTime now) {
+        final ZonedDateTime morning = now.withHour(FALLBACK_NIGHT_END_HOUR)
+                .withMinute(0).withSecond(0).withNano(0);
+        if (now.isBefore(morning)) {
+            return morning;
+        }
+        final ZonedDateTime evening = now.withHour(FALLBACK_NIGHT_START_HOUR)
+                .withMinute(0).withSecond(0).withNano(0);
+        if (now.isBefore(evening)) {
+            return evening;
+        }
+        return morning.plusDays(1);
+    }
+}
