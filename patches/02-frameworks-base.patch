+    private int mPrimaryTextColor;
+    private float mDozeAmount;
+
+    PurePixelDateSmartspaceView(Context context, boolean largeClock) {
+        super(context);
+        setId(largeClock
+                ? com.android.systemui.shared.R.id.date_smartspace_view_large
+                : com.android.systemui.shared.R.id.date_smartspace_view);
+        setOrientation(HORIZONTAL);
+        setGravity(Gravity.CENTER_VERTICAL);
+        setMinimumHeight(dp(32));
+
+        mDateView = new TextClock(context);
+        mDateView.setIncludeFontPadding(false);
+        mDateView.setSingleLine(true);
+        mDateView.setTextSize(TypedValue.COMPLEX_UNIT_SP, largeClock ? 16 : 14);
+        final String pattern = DateFormat.getBestDateTimePattern(
+                Locale.getDefault(), "EEE, MMM d");
+        mDateView.setFormat12Hour(pattern);
+        mDateView.setFormat24Hour(pattern);
+        mDateView.setPaddingRelative(0, 0, dp(WEATHER_GAP_DP), 0);
+        addView(mDateView, new LayoutParams(LayoutParams.WRAP_CONTENT, LayoutParams.WRAP_CONTENT));
+
+        mPrimaryTextColor = context.getColor(android.R.color.white);
+        updateTextColor();
+    }
+
