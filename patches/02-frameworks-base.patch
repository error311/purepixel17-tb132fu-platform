index 0000000000000000000000000000000000000000..e2535d82f90614bd47005db5db27195cb652d3d7
--- /dev/null
+++ b/core/java/com/android/internal/util/PixelTabletAppProps.java
@@ -0,0 +1,195 @@
+/*
