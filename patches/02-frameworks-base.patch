+/*
+ * Compatibility surface for Lenovo's stock TB132FU PenService.
+ */
+package com.zui.input.handwriting;
+
+import android.content.Context;
+
+/**
+ * No-op form of Lenovo's private ZUI handwriting manager.
+ *
+ * AOSP does not register the private zui_hand_writing service, so the
+ * unsupported global-handwriting backend remains disabled. Supplying only the
+ * exact class and method surface lets Lenovo's pairing/settings application
+ * start without claiming that backend is implemented.
+ *
+ * @hide
+ */
+public final class ZuiHandWritingManager {
+    public ZuiHandWritingManager(Context context) {}
+
+    public void registerIMEClient(IIMEClient client) {}
+
+    public void unregisterIMEClient(IIMEClient client) {}
+
+    public void setHwEnable(int enabled) {}
+
+    public void setToolType(int toolType) {}
+
+    public void checkHandwriting(int x, int y) {}
+
+    public boolean isHandwriting() {
+        return false;
+    }
+
+    public void tryToResetIme() {}
+}
