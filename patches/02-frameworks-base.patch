--- /dev/null
+++ b/core/java/com/zui/input/handwriting/IIMEClient.java
@@ -0,0 +1,35 @@
+/*
+ * Compatibility surface for Lenovo's stock TB132FU PenService.
+ *
+ * Lenovo's Android 14 framework exposes this Binder callback from its private
+ * ZUI handwriting framework. AOSP does not provide the corresponding system
+ * service, but PenService still verifies an anonymous implementation of this
+ * interface during Application startup.
+ */
+package com.zui.input.handwriting;
+
+import android.os.Binder;
+import android.os.IBinder;
+import android.os.IInterface;
+import android.os.RemoteException;
+
+/** @hide */
+public interface IIMEClient extends IInterface {
+    String DESCRIPTOR = "com.zui.input.handwriting.IIMEClient";
+
+    int isEditableByClient(int x, int y) throws RemoteException;
+
+    void onCallback(int value) throws RemoteException;
+
+    /** @hide */
+    abstract class Stub extends Binder implements IIMEClient {
+        public Stub() {
+            attachInterface(this, DESCRIPTOR);
+        }
+
+        @Override
+        public IBinder asBinder() {
+            return this;
+        }
+    }
+}
