+
+// Explicitly built, non-installed target probe for the TB132FU pre-BTF
+// compatibility object and tracepoint-attach fallback.
+cc_binary {
+    name: "timeinstate_tb132fu_probe",
+    srcs: ["Tb132fuTimeInStateProbe.cpp"],
+    static_libs: ["libtimeinstate"],
+    shared_libs: [
+        "libbase",
+        "libbpf_bcc",
+        "libbpf_minimal",
+        "liblog",
+    ],
+    compile_multilib: "64",
+    installable: false,
+}
