+
+#include <cputimeinstate.h>
+
+#include <cstdio>
+
+int main() {
+    const bool supported = android::bpf::isTrackingUidTimesSupported();
+    const bool started = supported && android::bpf::startTrackingUidTimes();
+    std::printf("TB132FU_TIME_IN_STATE supported=%d started=%d\n", supported, started);
+    return started ? 0 : 1;
+}
