+ * Compatibility build of timeInState for pre-BTF kernels.
+ *
+ * Keep the accounting implementation shared with timeInState.c; only omit
+ * the CO-RE task_struct cleanup program that cannot load without kernel BTF.
+ */
+#define BPF_LEGACY_NO_CORE_TASK
+#include "timeInState.c"
