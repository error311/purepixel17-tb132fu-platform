@@ -749,6 +757,16 @@ func runSoong(ctx Context, config Config, enforceNoSoongOutput bool) {
 			// This is currently how the command line to invoke soong_build finds the
 			// root of the source tree and the output root
 			ninjaEnv.Set("TOP", os.Getenv("TOP"))
+			// Preserve Go's soft memory limit for the generated soong_build process.
+			// The bootstrap ninja command otherwise starts it through `env -i`,
