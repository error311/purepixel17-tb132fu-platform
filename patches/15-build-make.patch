+      common.OPTIONS.stash_threshold = 0
+      self.assertEqual((6, 0), block_image_diff.ReviseStashSize())
+      self.assertEqual("new", transfer.style)
+      self.assertFalse(transfer.src_ranges)
+    finally:
+      common.OPTIONS.cache_size = old_cache_size
+      common.OPTIONS.stash_threshold = old_stash_threshold
