From c337c1af5d9c328e1aa5ce9c6603b92e072fffda Mon Sep 17 00:00:00 2001
From: error311 <error311@gmail.com>
Date: Wed, 26 Aug 2026 01:50:34 -0400
Subject: [PATCH 5/5] Bluetooth: bridge Android 17 libc++ abort ABI

Change-Id: I9b691c575afff143653c51f85d3f22ee3bd21c53
---
 system/audio_bluetooth_hw/Android.bp          |  9 +++++---
 .../tb132fu_libcpp_compat.cc                  | 23 +++++++++++++++++++
 2 files changed, 29 insertions(+), 3 deletions(-)
 create mode 100644 system/audio_bluetooth_hw/tb132fu_libcpp_compat.cc

diff --git a/system/audio_bluetooth_hw/Android.bp b/system/audio_bluetooth_hw/Android.bp
index 4948695..f6166b2 100644
--- a/system/audio_bluetooth_hw/Android.bp
+++ b/system/audio_bluetooth_hw/Android.bp
@@ -66,13 +66,16 @@ cc_library_shared {
     compile_multilib: "both",
     relative_install_path: "hw",
     // audioserver loads this module through Lenovo's Android 11 vendor
-    // namespace, whose libc++.so predates symbols used by Android 17 code.
-    // Keep the C++ runtime self-contained while retaining the vendor HIDL ABI.
-    stl: "libc++_static",
+    // namespace. Keep that namespace's single libc++ runtime and supply only
+    // the one newer diagnostic symbol referenced by Android 17 code. Linking
+    // the complete static runtime here creates duplicate iostream state in the
+    // MediaTek audio HAL and crashes its first Bluetooth output stream.
+    stl: "libc++",
     srcs: [
         "audio_bluetooth_hw.cc",
         "device_port_proxy_hidl.cc",
         "stream_apis.cc",
+        "tb132fu_libcpp_compat.cc",
         "utils.cc",
     ],
     header_libs: ["libhardware_headers"],
diff --git a/system/audio_bluetooth_hw/tb132fu_libcpp_compat.cc b/system/audio_bluetooth_hw/tb132fu_libcpp_compat.cc
new file mode 100644
index 0000000..9656083
--- /dev/null
+++ b/system/audio_bluetooth_hw/tb132fu_libcpp_compat.cc
@@ -0,0 +1,23 @@
+/*
+ * Copyright (C) 2026 The Android Open Source Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <android/log.h>
+#include <stdarg.h>
+#include <stdlib.h>
+
+// Android 17's libc++ headers can emit this diagnostic call, but the retained
+// TB132FU VNDK31 libc++.so does not export it. Define only that ABI symbol in
+// the bridge instead of embedding a second C++ runtime in MediaTek audioserver.
+extern "C" void tb132fu_libcpp_verbose_abort(const char* format, ...)
+        __asm__("_ZNSt3__122__libcpp_verbose_abortEPKcz");
+
+extern "C" __attribute__((noreturn)) void tb132fu_libcpp_verbose_abort(
+        const char* format, ...) {
+    va_list arguments;
+    va_start(arguments, format);
+    __android_log_vprint(ANDROID_LOG_FATAL, "PurePixelBluetooth", format, arguments);
+    va_end(arguments);
+    abort();
+}
-- 
2.55.0

