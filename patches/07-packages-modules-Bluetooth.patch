+// TB132FU's frozen MediaTek bridge links the private MediaTek session registry
+// while its provider implementation publishes sessions through the standard
+// AOSP registry. Build the standard bridge as a system-owned variant so the
+// native product can select it without modifying the retained vendor image.
+cc_library_shared {
+    name: "audio.bluetooth.purepixel",
+    defaults: ["audio_bluetooth_hw_defaults"],
+    cflags: ["-DTB132FU_BLUETOOTH_HIDL_ONLY"],
+    compile_multilib: "both",
+    relative_install_path: "hw",
+    srcs: [
+        "audio_bluetooth_hw.cc",
+        "device_port_proxy_hidl.cc",
+        "stream_apis.cc",
+        "utils.cc",
+    ],
+    header_libs: ["libhardware_headers"],
+    shared_libs: [
+        "libaudioutils",
+        "libbase",
+        "libcutils",
+        "libfmq",
+        "liblog",
+        "libutils",
+        // HIDL dependencies
+        "android.hardware.bluetooth.audio@2.0",
+        "android.hardware.bluetooth.audio@2.1",
+        "libbluetooth_audio_session",
+        "libhidlbase",
+    ],
+}
