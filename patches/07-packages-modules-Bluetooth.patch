From ed2ff9a93dd827f626db9c012d509f76852f6b7b Mon Sep 17 00:00:00 2001
From: error311 <error311@gmail.com>
Date: Mon, 17 Aug 2026 02:05:10 -0400
Subject: [PATCH 1/5] Bluetooth: tolerate stale HCI command responses

Change-Id: I0ba24b2199c4c29360b4ec548a1e47f9192fd4c6
---
 system/gd/hci/hci_layer.cc          | 11 +++++++++--
 system/gd/hci/hci_layer_unittest.cc | 26 ++++++++++++++++++++++++++
 2 files changed, 35 insertions(+), 2 deletions(-)

diff --git a/system/gd/hci/hci_layer.cc b/system/gd/hci/hci_layer.cc
index fd85769..fd1c5ba 100644
--- a/system/gd/hci/hci_layer.cc
+++ b/system/gd/hci/hci_layer.cc
@@ -253,8 +253,15 @@ struct HciLayer::impl {
       common::StopWatch::DumpStopWatchLog();
       return;
     }
-    log::assert_that(waiting_command_ == op_code, "Waiting for {}, got {}",
-                     OpCodeText(waiting_command_), OpCodeText(op_code));
+    if (waiting_command_ != op_code) {
+      // Some controllers can deliver a stale Command Complete after the next command has
+      // already been sent. Keep waiting for the outstanding command instead of aborting the
+      // Bluetooth process. The matching response or the existing HCI timeout will resolve the
+      // queue without invoking a callback for the stale event.
+      log::warn("Ignoring unexpected {} response while waiting for {} (got {})", logging_id,
+                OpCodeText(waiting_command_), OpCodeText(op_code));
+      return;
+    }
 
     bool is_vendor_specific = (static_cast<int>(op_code) & (0x3f << 10)) == (0x3f << 10);
     using WaitingFor = CommandQueueEntry::WaitingFor;
diff --git a/system/gd/hci/hci_layer_unittest.cc b/system/gd/hci/hci_layer_unittest.cc
index 27effdd..23de9e8 100644
--- a/system/gd/hci/hci_layer_unittest.cc
+++ b/system/gd/hci/hci_layer_unittest.cc
@@ -500,5 +500,31 @@ TEST_F(HciLayerTest, command_status_callback_is_invoked_with_failure_status) {
   sync_handler();
 }
 
+TEST_F(HciLayerTest, stale_command_response_is_ignored_while_waiting_for_current_command) {
+  std::promise<OpCode> callback_promise;
+  auto callback_future = callback_promise.get_future();
+
+  FailIfResetNotSent();
+  hal_->InjectEvent(ResetCompleteBuilder::Create(1, ErrorCode::SUCCESS));
+  hci_->EnqueueCommand(
+          ReadClockOffsetBuilder::Create(0x001),
+          client_handler_->BindOnce(
+                  [](std::promise<OpCode> promise, CommandStatusView view) {
+                    ASSERT_TRUE(view.IsValid());
+                    promise.set_value(view.GetCommandOpCode());
+                  },
+                  std::move(callback_promise)));
+
+  hal_->InjectEvent(CommandStatusBuilder::Create(ErrorCode::SUCCESS, 1,
+                                                 OpCode::LE_SET_EXTENDED_SCAN_ENABLE,
+                                                 std::make_unique<RawBuilder>()));
+  sync_handler();
+  ASSERT_EQ(std::future_status::timeout, callback_future.wait_for(10ms));
+
+  hal_->InjectEvent(ReadClockOffsetStatusBuilder::Create(ErrorCode::SUCCESS, 1));
+  ASSERT_EQ(std::future_status::ready, callback_future.wait_for(1s));
+  ASSERT_EQ(OpCode::READ_CLOCK_OFFSET, callback_future.get());
+}
+
 }  // namespace hci
 }  // namespace bluetooth
-- 
2.55.0


From b2740117a82ba51acf9dac6e4ee82150a40ea43f Mon Sep 17 00:00:00 2001
From: error311 <error311@gmail.com>
Date: Tue, 25 Aug 2026 20:20:17 -0400
Subject: [PATCH 2/5] Bluetooth: add a system-owned standard audio bridge

Change-Id: I5a6f885c6bf5e648c47f2b79321f8a6a13989622
---
 system/audio_bluetooth_hw/Android.bp | 38 ++++++++++++++++++++++++++++
 1 file changed, 38 insertions(+)

diff --git a/system/audio_bluetooth_hw/Android.bp b/system/audio_bluetooth_hw/Android.bp
index 1b8e850..10c2bc6 100644
--- a/system/audio_bluetooth_hw/Android.bp
+++ b/system/audio_bluetooth_hw/Android.bp
@@ -55,6 +55,44 @@ cc_library_shared {
     ],
 }
 
+// TB132FU's frozen MediaTek bridge links the private MediaTek session registry
+// while its provider implementation publishes sessions through the standard
+// AOSP registry. Build the standard bridge as a system-owned variant so the
+// native product can select it without modifying the retained vendor image.
+cc_library_shared {
+    name: "audio.bluetooth.purepixel",
+    defaults: [
+        "audio_bluetooth_hw_defaults",
+        "latest_android_hardware_audio_common_ndk_shared",
+        "latest_android_hardware_bluetooth_audio_ndk_shared",
+    ],
+    compile_multilib: "both",
+    relative_install_path: "hw",
+    srcs: [
+        "audio_bluetooth_hw.cc",
+        "device_port_proxy.cc",
+        "device_port_proxy_hidl.cc",
+        "stream_apis.cc",
+        "utils.cc",
+    ],
+    header_libs: ["libhardware_headers"],
+    shared_libs: [
+        "libaudioutils",
+        "libbase",
+        "libbinder_ndk",
+        "libbluetooth_audio_session_aidl",
+        "libcutils",
+        "libfmq",
+        "liblog",
+        "libutils",
+        // HIDL dependencies
+        "android.hardware.bluetooth.audio@2.0",
+        "android.hardware.bluetooth.audio@2.1",
+        "libbluetooth_audio_session",
+        "libhidlbase",
+    ],
+}
+
 cc_test {
     name: "audio_bluetooth_hw_test",
     test_suites: ["general-tests"],
-- 
2.55.0


